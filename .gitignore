# --- Build output ---
dist/
.output/
*.tsbuildinfo

# --- Dependencies ---
node_modules/

# --- Generated / cache ---
.astro/
.cache/
.eslintcache
.stylelintcache
coverage/

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Environment & secrets (never commit) ---
.env
.env.*
!.env.example

# --- Deploy platforms (local state) ---
.netlify/
.vercel/

# --- OS junk ---
.DS_Store
Thumbs.db
Desktop.ini

# --- Editors (except .vscode/, which is shared template config) ---
.idea/
*.swp
*.swo
*~

# --- Local AI-assistant settings ---
.claude/

# --- Alternate lockfiles (project uses package-lock.json) ---
pnpm-lock.yaml
yarn.lock
bun.lockb

# --- Local docs (git doesn't understand a leading './'; files that are
#     already tracked also need: git rm -r --cached docs) ---
/docs/
