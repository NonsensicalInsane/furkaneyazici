---
import '@fontsource-variable/inter';
---

<style is:inline is:global>
  /*
    Single source of truth for the site palette.
    Identity: blue → violet ("quantum" gradient), dark-first.
    Every gradient/accent in the site derives from these variables.
  */
  :root {
    --aw-font-sans: 'Inter Variable';
    --aw-font-serif: var(--aw-font-sans);
    --aw-font-heading: var(--aw-font-sans);

    --aw-color-primary: rgb(37 99 235); /* blue-600 */
    --aw-color-secondary: rgb(29 78 216); /* blue-700 */
    --aw-color-accent: rgb(124 58 237); /* violet-600 */

    /* Brand gradient — use everywhere instead of ad-hoc hex pairs */
    --aw-gradient: linear-gradient(135deg, var(--aw-color-primary) 0%, var(--aw-color-accent) 100%);

    --aw-color-text-heading: rgb(15 23 42);
    --aw-color-text-default: rgb(30 41 59);
    --aw-color-text-muted: rgb(30 41 59 / 66%);
    --aw-color-bg-page: rgb(255 255 255);

    --aw-color-bg-page-dark: rgb(3 6 23);

    ::selection {
      background-color: var(--aw-color-primary);
      color: white;
    }
  }

  .dark {
    --aw-color-primary: rgb(59 130 246); /* blue-500 — brighter on dark bg */
    --aw-color-secondary: rgb(37 99 235); /* blue-600 */
    --aw-color-accent: rgb(139 92 246); /* violet-500 */

    --aw-color-text-heading: rgb(241 245 249);
    --aw-color-text-default: rgb(226 232 240);
    --aw-color-text-muted: rgb(226 232 240 / 66%);
    --aw-color-bg-page: var(--aw-color-bg-page-dark);

    ::selection {
      background-color: var(--aw-color-accent);
      color: white;
    }
  }
</style>
