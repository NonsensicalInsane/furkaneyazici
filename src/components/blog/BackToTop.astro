---
import { Icon } from 'astro-icon/components';
---

<button
  id="back-to-top"
  class="fixed bottom-8 right-8 p-3 bg-primary hover:bg-primary-600 text-white rounded-full shadow-lg hover:shadow-xl transition-all duration-300 opacity-0 invisible z-50"
  aria-label="Back to top"
>
  <Icon name="tabler:arrow-up" class="w-5 h-5" />
</button>

<script>
  function initBackToTop() {
    const backToTopButton = document.getElementById('back-to-top');
    if (!backToTopButton || backToTopButton.dataset.bound === 'true') return;
    backToTopButton.dataset.bound = 'true';

    // Show/hide button based on scroll position
    function toggleButton() {
      if (!backToTopButton) return;
      
      if (window.scrollY > 300) {
        backToTopButton.classList.remove('opacity-0', 'invisible');
        backToTopButton.classList.add('opacity-100', 'visible');
      } else {
        backToTopButton.classList.add('opacity-0', 'invisible');
        backToTopButton.classList.remove('opacity-100', 'visible');
      }
    }

    // Smooth scroll to top
    function scrollToTop() {
      window.scrollTo({
        top: 0,
        behavior: 'smooth'
      });
    }

    // Event listeners. `window` survives client-side navigation, so drop the
    // scroll listener before the next page swaps in.
    const controller = new AbortController();
    window.addEventListener('scroll', toggleButton, { passive: true, signal: controller.signal });
    document.addEventListener('astro:before-swap', () => controller.abort(), { once: true });
    backToTopButton.addEventListener('click', scrollToTop);

    // Initial check
    toggleButton();
  }

  // This module runs once per visit; astro:page-load re-runs init after every
  // client-side navigation (and on the first load too).
  initBackToTop();
  document.addEventListener('astro:page-load', initBackToTop);
</script>