---
import { ui } from '../../i18n/ui';
import { Icon } from 'astro-icon/components';

export interface Props {
  type?: 'note' | 'tip' | 'warning' | 'important';
  title?: string;
}

const { type = 'note', title } = Astro.props;

const variants = {
  note: {
    icon: 'tabler:info-circle',
    label: 'Note',
    box: 'border-blue-500/50 bg-blue-500/10',
    accent: 'text-blue-600 dark:text-blue-400',
  },
  tip: {
    icon: 'tabler:bulb',
    label: 'Tip',
    box: 'border-emerald-500/50 bg-emerald-500/10',
    accent: 'text-emerald-600 dark:text-emerald-400',
  },
  warning: {
    icon: 'tabler:alert-triangle',
    label: 'Warning',
    box: 'border-amber-500/50 bg-amber-500/10',
    accent: 'text-amber-600 dark:text-amber-400',
  },
  important: {
    icon: 'tabler:flame',
    label: 'Important',
    box: 'border-violet-500/50 bg-violet-500/10',
    accent: 'text-violet-600 dark:text-violet-400',
  },
};

const variant = variants[type] ?? variants.note;
// The default title in the post's language ("Not", "ヒント"…)
const label = ui(Astro.locals.postLang).callout[type in variants ? type : 'note'];
---

<aside class={`callout not-prose my-6 rounded-lg border-l-4 px-4 py-3 sm:px-5 sm:py-4 ${variant.box}`} role="note">
  <p class={`flex items-center gap-2 font-semibold text-sm uppercase tracking-wide mb-2 ${variant.accent}`}>
    <Icon name={variant.icon} class="w-5 h-5 shrink-0" />
    {title ?? label}
  </p>
  <div class="callout-body text-[0.95rem] leading-relaxed text-gray-700 dark:text-slate-300">
    <slot />
  </div>
</aside>
