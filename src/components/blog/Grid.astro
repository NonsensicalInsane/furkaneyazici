---
import Item from '../../components/blog/GridItem.astro';
import type { Post } from '../../types';

export interface Props {
  posts: Array<Post>;
  /** Render the first (newest) post as a full-width feature card */
  featureFirst?: boolean;
  /** Centre the cards (flex rather than grid), so one or two posts don't leave empty columns */
  centered?: boolean;
}

const { posts, featureFirst = false, centered = false } = Astro.props;
---

{
  centered ? (
    <div class="flex flex-wrap justify-center gap-8">
      {posts.map((post) => (
        <div class="w-full md:w-[calc((100%-2rem)/2)] lg:w-[calc((100%-4rem)/3)]">
          <Item post={post} />
        </div>
      ))}
    </div>
  ) : (
    <div class="grid gap-8 md:gap-10 lg:gap-12 md:grid-cols-2 lg:grid-cols-3 mb-8">
      {posts.map((post, index) => (
        <Item post={post} isFeatured={featureFirst && index === 0} />
      ))}
    </div>
  )
}
