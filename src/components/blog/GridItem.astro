---
import { APP_BLOG, I18N } from '../../utils/config';
import type { Post } from '../../types';
import { Icon } from 'astro-icon/components';

import Image from '../../components/common/Image.astro';
import PostTags from '../../components/blog/Tags.astro';

import { findImage } from '../../utils/images';
import { coverUrl } from '../../utils/covers';
import { LEVELS } from '../../utils/blog';
import { getPermalink } from '../../utils/permalinks';
import { getFormattedDate } from '../../utils/utils';

export interface Props {
  post: Post;
  /** Full-width horizontal layout for the newest post */
  isFeatured?: boolean;
}

const { post, isFeatured = false } = Astro.props;
// Posts without an image get a generated cover when cardCovers is on (config.yaml),
// otherwise a text-only card
const image = (await findImage(post.image)) ?? coverUrl(post, 'card');
const link = APP_BLOG?.post?.isEnabled ? getPermalink(post.permalink, 'post') : '';
// Badge only for posts not in the site's default language
const langBadge = post.lang && post.lang !== (I18N.language || 'en') ? post.lang.toUpperCase() : undefined;
---

<article
  class:list={[
    'group h-full flex flex-col bg-white dark:bg-slate-900 rounded-xl shadow-lg hover:shadow-xl transition-all duration-300 overflow-hidden border border-gray-100 dark:border-slate-800 hover:border-gray-200 dark:hover:border-slate-700 card-hover scroll-reveal',
    isFeatured && 'md:col-span-2 lg:col-span-3',
  ]}
  data-blog-post={post.slug}
>
  <div class:list={['flex-1 flex flex-col', isFeatured && image && 'md:grid md:grid-cols-2']}>
    {
      image && (
        <div class="relative overflow-hidden">
          {/* Same target as the title link: clickable, but skipped by keyboard and screen readers */}
          <a href={link || 'javascript:void(0)'} class="block h-full" tabindex="-1" aria-hidden="true">
            <Image
              src={image}
              class:list={[
                'w-full object-cover group-hover:scale-105 transition-transform duration-300',
                isFeatured ? 'h-48 sm:h-64 md:h-full' : 'h-48',
              ]}
              widths={[400, 600, 900]}
              width={isFeatured ? 900 : 600}
              sizes={isFeatured ? '(max-width: 768px) 400px, 900px' : '(max-width: 768px) 400px, 600px'}
              alt={post.title}
              aspectRatio={isFeatured ? undefined : '16:9'}
              loading={isFeatured ? 'eager' : 'lazy'}
              decoding="async"
            />
          </a>
          {post.category && (
            <div class="absolute top-4 left-4">
              <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-primary/90 text-white backdrop-blur-sm">
                {post.category.replaceAll('-', ' ')}
              </span>
            </div>
          )}
          {isFeatured && (
            <div class="absolute top-4 right-4">
              <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full text-xs font-semibold bg-white/90 text-gray-900 backdrop-blur-sm dark:bg-slate-900/90 dark:text-white">
                <Icon name="tabler:sparkles" class="w-3.5 h-3.5" />
                Latest
              </span>
            </div>
          )}
        </div>
      )
    }

    <div class:list={[isFeatured ? 'p-6 md:p-8 lg:p-10 flex flex-col justify-center' : 'p-6 flex-1 flex flex-col']}>
      {
        !image && (post.category || isFeatured) && (
          <div class="flex flex-wrap items-center gap-2 mb-4">
            {post.category && (
              <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold capitalize bg-blue-500/10 text-blue-300 ring-1 ring-inset ring-blue-400/20">
                {post.category.replaceAll('-', ' ')}
              </span>
            )}
            {isFeatured && (
              <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full text-xs font-semibold text-slate-300 ring-1 ring-inset ring-white/15">
                <Icon name="tabler:sparkles" class="w-3.5 h-3.5" />
                Latest
              </span>
            )}
          </div>
        )
      }
      <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-gray-500 dark:text-slate-400 mb-3 [&>*]:whitespace-nowrap">
        <div class="flex items-center gap-1">
          <Icon name="tabler:clock" class="w-4 h-4" />
          <time datetime={post.publishDate.toISOString()}>{getFormattedDate(post.publishDate)}</time>
        </div>
        {
          post.readingTime && (
            <div class="flex items-center gap-1">
              <Icon name="tabler:book" class="w-4 h-4" />
              <span>{post.readingTime} min read</span>
            </div>
          )
        }
        {post.level && (
          <span class="inline-flex items-center gap-1">
            <Icon name={LEVELS[post.level].icon} class={`w-4 h-4 ${LEVELS[post.level].color}`} />
            {LEVELS[post.level].label}
          </span>
        )}
        {post.draft && (
          <span class="inline-flex items-center px-2 py-0.5 rounded-md text-xs font-semibold border border-amber-400/40 text-amber-400">
            Draft
          </span>
        )}
        {
          langBadge && (
            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md text-xs font-semibold border border-gray-200 dark:border-slate-700 text-gray-600 dark:text-slate-300">
              <Icon name="tabler:language" class="w-3.5 h-3.5" />
              {langBadge}
            </span>
          )
        }
      </div>

      <h3
        class:list={[
          'font-bold leading-tight mb-3 font-heading group-hover:text-primary dark:group-hover:text-blue-400 transition-colors duration-200',
          isFeatured ? 'text-2xl md:text-3xl' : 'text-xl',
        ]}
      >
        {
          link ? (
            <a href={link} class="block">
              {post.title}
            </a>
          ) : (
            post.title
          )
        }
      </h3>

      {
        post.excerpt && (
          <p
            class:list={[
              'text-gray-600 dark:text-slate-300 text-base leading-relaxed mb-4',
              isFeatured ? 'md:text-lg line-clamp-4' : 'line-clamp-3',
            ]}
          >
            {post.excerpt}
          </p>
        )
      }

      <!-- mt-auto: tags and "Read more" sit on the card's bottom edge -->
      <div class="flex items-center justify-between mt-auto pt-2">
        <PostTags tags={post.tags} class="flex-1" />
        {
          link && (
            <a
              href={link}
              class="inline-flex items-center text-primary dark:text-blue-400 hover:text-primary-600 dark:hover:text-blue-300 font-medium text-sm transition-colors duration-200"
            >
              Read more
              <Icon name="tabler:arrow-right" class="w-4 h-4 ml-1" />
            </a>
          )
        }
      </div>
    </div>
  </div>
</article>
