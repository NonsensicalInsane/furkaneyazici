---
import { NEWSLETTER } from '../../utils/config';
import { getAsset } from '../../utils/permalinks';

// Shown once a Buttondown username is set in src/config.yaml (newsletter.buttondown).
// Until then it appears in development only, as a preview that doesn't submit.
const username = NEWSLETTER.buttondown;
const isPreview = !username && import.meta.env.DEV;
---

{
  (username || isPreview) && (
    <section class="cta-panel mt-12 rounded-2xl border border-white/10 px-6 py-8 sm:px-8 print:hidden" aria-labelledby="newsletter-heading">
      <p class="eyebrow">Newsletter</p>
      <h2 id="newsletter-heading" class="mt-2 text-2xl font-bold tracking-tight text-heading">
        Get new posts by email
      </h2>
      <p class="mt-2 text-slate-300">An email when a new post is out, nothing else. Unsubscribe any time.</p>
      {/* A plain form post, no script: Buttondown confirms the address in a new tab */}
      <form
        action={username ? `https://buttondown.com/api/emails/embed-subscribe/${encodeURIComponent(username)}` : undefined}
        method="post"
        target="_blank"
        class="mt-5 flex flex-col gap-3 sm:flex-row"
      >
        <label for="newsletter-email" class="sr-only">Email address</label>
        <input
          id="newsletter-email"
          type="email"
          name="email"
          required
          autocomplete="email"
          placeholder="you@example.com"
          class="w-full sm:flex-1 rounded-full border border-white/15 bg-slate-900/60 px-5 py-3 text-white placeholder:text-slate-500 focus:border-transparent focus:ring-2 focus:ring-primary"
        />
        <input type="hidden" name="embed" value="1" />
        <button type="submit" class="btn-primary shrink-0 disabled:opacity-50 disabled:cursor-not-allowed" disabled={isPreview}>
          Subscribe
        </button>
      </form>
      <p class="mt-3 text-xs text-slate-400">
        Sent with Buttondown. Prefer a feed reader? Follow the <a href={getAsset('/rss.xml')} class="inline-link">RSS feed</a>.
      </p>
      {
        isPreview && (
          <p class="mt-3 text-xs font-semibold text-amber-400">
            Preview (development only): set newsletter.buttondown in src/config.yaml to switch the form on.
          </p>
        )
      }
    </section>
  )
}
