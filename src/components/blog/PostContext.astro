---
import { Icon } from 'astro-icon/components';
import type { Post } from '../../types';
import { fetchPosts, LEVELS } from '../../utils/blog';
import { getPermalink, trimSlash } from '../../utils/permalinks';
import { ui } from '../../i18n/ui';

export interface Props {
  post: Post;
}

// Level and prerequisites, above the post. A prerequisite starting with "/" is
// another post's URL and links to it by title; an unknown URL stops the build.
const { post } = Astro.props;
const t = ui(post.lang);
const prerequisites = post.prerequisites ?? [];
const posts = prerequisites.some((p) => p.startsWith('/')) ? await fetchPosts() : [];
const items = prerequisites.map((item) => {
  if (!item.startsWith('/')) return { text: item };
  const target = posts.find((p) => trimSlash(getPermalink(p.permalink, 'post')) === trimSlash(item));
  if (!target) throw new Error(`Prerequisite "${item}" in "${post.title}" isn't the URL of a post`);
  return { text: target.title, href: getPermalink(target.permalink, 'post') };
});
---

{
  (post.level || items.length > 0) && (
    <div class="max-w-3xl mx-auto mb-8 px-4 sm:px-6">
      <dl class="flex flex-col gap-2 rounded-xl border border-white/10 bg-white/[0.03] px-4 py-3 text-sm sm:flex-row sm:flex-wrap sm:gap-x-6">
        {post.level && (
          <div class="flex items-center gap-2">
            <dt class="text-slate-400">{t.level}</dt>
            <dd class="inline-flex items-center gap-1.5 font-semibold text-heading">
              <Icon name={LEVELS[post.level].icon} class={`w-4 h-4 ${LEVELS[post.level].color}`} />
              {t.levels[post.level]}
            </dd>
          </div>
        )}
        {items.length > 0 && (
          <div class="flex items-start gap-2">
            <dt class="inline-flex shrink-0 items-center gap-1.5 text-slate-400">
              <Icon name="tabler:list-check" class="w-4 h-4 text-blue-400" />
              {t.beforeYouRead}
            </dt>
            <dd class="text-slate-200">
              {items.map((item, i) => (
                <>
                  {item.href ? (
                    <a href={item.href} class="inline-link">
                      {item.text}
                    </a>
                  ) : (
                    item.text
                  )}
                  {i < items.length - 1 && <span class="text-slate-500">{' · '}</span>}
                </>
              ))}
            </dd>
          </div>
        )}
      </dl>
    </div>
  )
}
