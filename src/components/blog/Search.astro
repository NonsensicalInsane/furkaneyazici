---
import { Icon } from 'astro-icon/components';
import { fetchPosts } from '../../utils/blog';
import { getPermalink } from '../../utils/permalinks';

// Search covers every post, not just the ones on the current page of the
// paginated list: a small index is embedded at build time.
const posts = await fetchPosts();
const index = posts.map((post) => ({
  title: post.title,
  excerpt: post.excerpt || '',
  tags: (post.tags || []).join(' '),
  category: post.category?.replaceAll('-', ' ') || '',
  url: getPermalink(post.permalink, 'post'),
}));
// Escape "<" so a title containing "</script>" can't end the JSON block early
const indexJson = JSON.stringify(index).replace(/</g, '\\u003c');
---

<div class="relative max-w-md mx-auto mb-8" data-blog-search>
  <div class="relative">
    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
      <Icon name="tabler:search" class="h-5 w-5 text-gray-400 dark:text-slate-500" />
    </div>
    <label for="blog-search" class="sr-only">Search posts</label>
    <input
      type="search"
      id="blog-search"
      class="block w-full pl-10 pr-3 py-3 border border-gray-200 dark:border-slate-700 rounded-lg bg-white dark:bg-slate-800 text-gray-900 dark:text-slate-100 placeholder-gray-500 dark:placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-all duration-200"
      placeholder="Search posts..."
      autocomplete="off"
      aria-controls="search-results"
      aria-expanded="false"
    />
  </div>
  <div
    id="search-results"
    class="absolute top-full left-0 right-0 mt-2 bg-white dark:bg-slate-800 border border-gray-200 dark:border-slate-700 rounded-lg shadow-lg z-10 hidden max-h-96 overflow-y-auto"
    aria-live="polite"
  >
  </div>
  <script is:inline type="application/json" id="blog-search-index" set:html={indexJson} />
</div>

<script>
  type Entry = { title: string; excerpt: string; tags: string; category: string; url: string };

  function initBlogSearch() {
    const root = document.querySelector<HTMLElement>('[data-blog-search]');
    const input = document.getElementById('blog-search') as HTMLInputElement | null;
    const results = document.getElementById('search-results');
    const data = document.getElementById('blog-search-index');
    if (!root || !input || !results || !data) return;

    const entries: Entry[] = JSON.parse(data.textContent || '[]');
    const haystacks = entries.map((e) => `${e.title} ${e.excerpt} ${e.tags} ${e.category}`.toLowerCase());

    const close = () => {
      results.classList.add('hidden');
      input.setAttribute('aria-expanded', 'false');
    };

    // Results are built with textContent, never innerHTML
    const render = (query: string) => {
      const words = query.split(/\s+/).filter(Boolean);
      const matches = entries.filter((_, i) => words.every((w) => haystacks[i].includes(w))).slice(0, 8);
      results.replaceChildren();

      if (matches.length === 0) {
        const empty = document.createElement('p');
        empty.className = 'px-4 py-3 text-sm text-gray-500 dark:text-slate-400';
        empty.textContent = 'No posts found — try other words.';
        results.append(empty);
      } else {
        const list = document.createElement('ul');
        for (const match of matches) {
          const link = document.createElement('a');
          link.href = match.url;
          link.className = 'block px-4 py-3 hover:bg-gray-50 dark:hover:bg-slate-700 transition-colors';
          const title = document.createElement('span');
          title.className = 'block font-medium text-gray-900 dark:text-white';
          title.textContent = match.title;
          link.append(title);
          if (match.excerpt) {
            const excerpt = document.createElement('span');
            excerpt.className = 'block mt-0.5 text-sm text-gray-500 dark:text-slate-400 line-clamp-2';
            excerpt.textContent = match.excerpt;
            link.append(excerpt);
          }
          const item = document.createElement('li');
          item.append(link);
          list.append(item);
        }
        results.append(list);
      }

      results.classList.remove('hidden');
      input.setAttribute('aria-expanded', 'true');
    };

    let timer: ReturnType<typeof setTimeout> | undefined;
    input.addEventListener('input', () => {
      clearTimeout(timer);
      const query = input.value.toLowerCase().trim();
      if (!query) return close();
      timer = setTimeout(() => render(query), 150);
    });
    input.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        input.value = '';
        close();
      }
    });

    // Close when clicking outside
    document.addEventListener('click', (e) => {
      if (!root.contains(e.target as Node)) close();
    });
  }

  initBlogSearch();
</script>
