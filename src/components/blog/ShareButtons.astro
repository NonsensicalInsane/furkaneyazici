---
import { Icon } from 'astro-icon/components';
import { ui } from '../../i18n/ui';

export interface Props {
  title: string;
  url: string;
  excerpt?: string;
  className?: string;
}

const { title, url, excerpt = '', className = '' } = Astro.props;
const shareText = excerpt || `Check out "${title}" by Furkan Eşref Yazıcı`;
const t = ui(Astro.locals.postLang);
---

<div class={`flex items-center gap-2 ${className}`} data-share-title={title} data-share-url={url} data-share-text={shareText}>
  <span class="text-sm font-medium text-slate-400">{t.share}</span>
  
  <!-- Twitter -->
  <button 
    class="share-button"
    type="button"
    data-post-share="twitter"
    aria-label={t.shareOn('X')}
  >
    <Icon name="tabler:brand-x" class="w-4 h-4" />
  </button>
  
  <!-- LinkedIn -->
  <button 
    class="share-button"
    type="button"
    data-post-share="linkedin"
    aria-label={t.shareOn('LinkedIn')}
  >
    <Icon name="tabler:brand-linkedin" class="w-4 h-4" />
  </button>
  
  <!-- Reddit -->
  <button 
    class="share-button"
    type="button"
    data-post-share="reddit"
    aria-label={t.shareOn('Reddit')}
  >
    <Icon name="tabler:brand-reddit" class="w-4 h-4" />
  </button>
  
  <!-- Copy Link -->
  <button 
    class="share-button"
    type="button"
    data-post-share="copy"
    aria-label={t.copyLink}
  >
    <Icon name="tabler:link" class="w-4 h-4" />
  </button>
  
  <!-- Email -->
  <button 
    class="share-button"
    type="button"
    data-post-share="email"
    aria-label={t.shareByEmail}
  >
    <Icon name="tabler:mail" class="w-4 h-4" />
  </button>
</div>

<script>
  import { uiText } from '../../scripts/ui-strings.js';

  // One delegated listener. Values come from
  // data-* attributes, so an apostrophe in a title ("I'm", "Let's") can't break
  // the code the way it would inside an inline onclick="…" string.
  document.addEventListener('click', (e) => {
    const btn = (e.target as Element | null)?.closest<HTMLElement>('[data-post-share]');
    const box = btn?.closest<HTMLElement>('[data-share-url]');
    if (!btn || !box) return;
    const { shareTitle = '', shareUrl = '', shareText = '' } = box.dataset;
    sharePost(shareTitle, shareUrl, shareText, btn.dataset.postShare || '');
  });

  function sharePost(title: string, url: string, text: string, platform: string) {
    const fullUrl = new URL(url, window.location.origin).href;
    
    switch(platform) {
      case 'twitter':
        window.open(`https://twitter.com/intent/tweet?text=${encodeURIComponent(text)}&url=${encodeURIComponent(fullUrl)}`, '_blank', 'noopener,width=600,height=400');
        break;
      case 'linkedin':
        window.open(`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(fullUrl)}`, '_blank', 'noopener,width=600,height=400');
        break;
      case 'reddit':
        window.open(`https://reddit.com/submit?url=${encodeURIComponent(fullUrl)}&title=${encodeURIComponent(title)}`, '_blank', 'noopener,width=600,height=600');
        break;
      case 'email':
        window.location.href = `mailto:?subject=${encodeURIComponent(title)}&body=${encodeURIComponent(text + '\n\n' + fullUrl)}`;
        break;
      case 'copy':
        navigator.clipboard.writeText(fullUrl).then(() => {
          showToast(uiText('linkCopied', 'Link copied to clipboard!'), 'success');
        }).catch(() => {
          showToast(uiText('linkCopyFailed', 'Failed to copy link'), 'error');
        });
        break;
    }
  }

  function showToast(message: string, type: string = 'success') {
    const toast = document.createElement('div');
    toast.textContent = message;
    toast.className = `fixed bottom-4 right-4 px-4 py-2 rounded-lg shadow-lg z-50 animate-slide-in-right ${
      type === 'success' ? 'bg-green-500 text-white' : 'bg-red-500 text-white'
    }`;
    document.body.appendChild(toast);
    setTimeout(() => toast.remove(), 3000);
  }
</script>
