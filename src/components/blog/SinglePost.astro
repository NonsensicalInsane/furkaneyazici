---
import { Icon } from 'astro-icon/components';

import Image from '../../components/common/Image.astro';
import PostTags from '../../components/blog/Tags.astro';
import ShareButtons from '../../components/blog/ShareButtons.astro';
import ReadingSettings from '../../components/blog/ReadingSettings.astro';
import Newsletter from '../../components/blog/Newsletter.astro';
import SeriesNav from '../../components/blog/SeriesNav.astro';
import PostContext from '../../components/blog/PostContext.astro';
import ReadingProgressBar from '../../components/blog/ReadingProgressBar.astro';
import TableOfContents from '../../components/blog/TableOfContents.astro';
import Callout from '../../components/blog/Callout.astro';
import Quote from '../../components/blog/Quote.astro';
// Rich-content components, available in every post without an import
import Figure from '../../components/content/Figure.astro';
import PlotlyChart from '../../components/content/PlotlyChart.astro';
import Animation from '../../components/content/Animation.astro';
import Definition from '../../components/content/Definition.astro';
import Theorem from '../../components/content/Theorem.astro';
import Lemma from '../../components/content/Lemma.astro';
import Proof from '../../components/content/Proof.astro';
import Term from '../../components/content/Term.astro';

import { getPermalink } from '../../utils/permalinks';
import { getFormattedDate, toJsonLd } from '../../utils/utils';
import { languageName } from '../../utils/blog';

import type { Post } from '../../types';

export interface Props {
  post: Post;
  url: string | URL;
  /** Other language versions of this post (same translationKey) */
  translations?: Array<Post>;
}

const { post, url, translations = [] } = Astro.props;
const { Content } = post;
// <Term> in the post's body reads this to pick the definition's language
Astro.locals.postLang = post.lang;

// Structured data: helps search engines & AI answer engines feature the
// article (rich results, citations) without them needing to guess.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.title,
  description: post.excerpt,
  ...(post.abstract ? { abstract: post.abstract } : {}),
  datePublished: post.publishDate ? new Date(post.publishDate).toISOString() : undefined,
  dateModified: post.updateDate ? new Date(post.updateDate).toISOString() : undefined,
  author: {
    '@type': 'Person',
    name: post.author || 'Furkan Eşref Yazıcı',
    url: 'https://furkaneyazici.com/about',
  },
  mainEntityOfPage: { '@type': 'WebPage', '@id': String(url) },
  license: 'https://creativecommons.org/licenses/by-nc-nd/4.0/',
  ...(post.lang ? { inLanguage: post.lang } : {}),
  ...(typeof post.image === 'string'
    ? { image: post.image }
    : post.image && typeof post.image === 'object' && 'src' in post.image
      ? { image: new URL((post.image as { src: string }).src, url).href }
      : {}),
};
---

<script is:inline type="application/ld+json" set:html={toJsonLd(jsonLd)} />

<section class="py-8 sm:py-16 lg:py-20 mx-auto">
  <!-- Reading Progress Bar -->
  <ReadingProgressBar minutes={post.readingTime} />
  
  <article lang={post.lang}>
    <header class={post.image ? '' : ''}>
      <div
        class="flex justify-between flex-col sm:flex-row gap-3 max-w-3xl mx-auto mt-0 mb-2 px-4 sm:px-6 sm:items-center animate-fade-in-up"
      >
        <p>
          <Icon name="tabler:clock" class="w-4 h-4 inline-block -mt-0.5 dark:text-gray-400" />
          <time datetime={post.publishDate.toISOString()} class="inline-block">{getFormattedDate(post.publishDate)}</time>
          {
            post.author && (
              <>
                {' '}
                · <Icon name="tabler:user" class="w-4 h-4 inline-block -mt-0.5 dark:text-gray-400" />
                <span class="inline-block">{post.author}</span>
              </>
            )
          }
          {
            post.category && (
              <>
                {' '}
                ·{' '}
                <a class="capitalize hover:underline inline-block" href={getPermalink(post.category, 'category')}>
                  {post.category.replaceAll('-', ' ')}
                </a>
              </>
            )
          }
          {
            post.readingTime && (
              <>
                &nbsp;· <span>{post.readingTime}</span> min read
              </>
            )
          }
        </p>
        <ReadingSettings />
      </div>

      {
        translations.length > 0 && (
          <div class="flex flex-wrap items-center gap-2 max-w-3xl mx-auto mb-3 px-4 sm:px-6 text-sm animate-fade-in-up">
            <Icon name="tabler:language" class="w-4 h-4 text-muted dark:text-slate-400" />
            <span class="text-muted dark:text-slate-400">Also available in:</span>
            {translations.map((t) => (
              <a
                href={getPermalink(t.permalink, 'post')}
                hreflang={t.lang}
                lang={t.lang}
                class="inline-flex items-center px-2.5 py-0.5 rounded-full border border-gray-200 dark:border-slate-700 text-primary dark:text-blue-400 hover:bg-gray-50 dark:hover:bg-slate-800 transition-colors font-medium"
              >
                {languageName(t.lang || '')}
              </a>
            ))}
          </div>
        )
      }

      {
        post.draft && (
          <p class="max-w-3xl mx-auto mb-3 px-4 sm:px-6 text-sm font-semibold text-amber-400">
            Draft: only visible in development, not published.
          </p>
        )
      }
      <h1
        class="px-4 sm:px-6 max-w-3xl mx-auto text-4xl md:text-5xl font-bold leading-tighter tracking-tighter font-heading text-balance animate-fade-in-up delay-150"
      >
        {post.title}
      </h1>
      <p
        class="max-w-3xl mx-auto mt-4 mb-8 px-4 sm:px-6 text-lg md:text-xl text-muted dark:text-slate-400 leading-relaxed animate-fade-in-up delay-300"
      >
        {post.excerpt}
      </p>

      <SeriesNav post={post} variant="top" />
      <PostContext post={post} />

      {
        post.abstract && (
          <section class="post-abstract max-w-3xl mx-auto mb-8 px-4 sm:px-6" aria-labelledby="abstract-heading">
            <div class="post-abstract-box">
              <h2 id="abstract-heading" class="post-abstract-heading">
                Abstract
              </h2>
              <p>{post.abstract}</p>
            </div>
          </section>
        )
      }

      {
        post.image ? (
          <Image
            src={post.image}
            class="max-w-full lg:max-w-[900px] mx-auto mb-6 sm:rounded-md bg-gray-400 dark:bg-slate-700"
            widths={[400, 900]}
            sizes="(max-width: 900px) 400px, 900px"
            alt={post?.excerpt || ''}
            width={900}
            height={506}
            loading="eager"
            decoding="async"
          />
        ) : (
          <div class="max-w-3xl mx-auto px-4 sm:px-6">
            <div class="border-t dark:border-slate-700" />
          </div>
        )
      }
    </header>
    <div class="mx-auto max-w-3xl xl:max-w-7xl xl:grid xl:grid-cols-[1fr_minmax(0,48rem)_1fr] xl:gap-8 mt-8">
      <!-- Left margin: footnotes appear here as sidenotes on wide screens (script below) -->
      <div class="hidden xl:block relative" aria-hidden="true" data-sidenotes></div>
      <div class="min-w-0">
        <div class="px-6 sm:px-6 mb-6 xl:hidden print:hidden">
          <TableOfContents headings={post.headings} variant="inline" />
        </div>
        <div
          class="post-body mx-auto px-6 sm:px-6 max-w-3xl prose dark:prose-invert dark:prose-headings:text-slate-300 prose-headings:font-heading prose-headings:leading-tighter prose-headings:tracking-tighter prose-headings:font-bold prose-a:text-primary dark:prose-a:text-blue-400 prose-img:rounded-md prose-img:shadow-lg prose-headings:scroll-mt-[80px]"
        >
          {Content ? <Content components={{ Callout, Quote, Figure, PlotlyChart, Animation, Definition, Theorem, Lemma, Proof, Term }} /> : <Fragment set:html={post.content || ''} />}
        </div>
      </div>
      <aside class="hidden xl:block print:hidden">
        <div class="sticky top-24">
          <TableOfContents headings={post.headings} variant="sidebar" />
        </div>
      </aside>
    </div>
    <div class="mx-auto px-6 sm:px-6 max-w-3xl mt-8">
      <SeriesNav post={post} variant="bottom" />
      <div class="flex justify-between flex-col sm:flex-row mb-6 mt-8">
        <PostTags tags={post.tags} class="mr-5 rtl:mr-0 rtl:ml-5" />
      </div>
      
      <!-- Enhanced Share Buttons -->
      <div class="border-t border-gray-200 dark:border-slate-700 pt-6 print:hidden">
        <ShareButtons 
          title={post.title}
          url={String(url)}
          excerpt={post.excerpt}
          className="justify-center"
        />
      </div>

      <Newsletter />
    </div>
  </article>
</section>

<script>
  // Copy attribution: long selections copied from the article automatically
  // carry the source and license. Short quotes are left untouched, and
  // reading/selecting is never blocked — this protects attribution without
  // hurting readers or accessibility.
  function initCopyAttribution() {
    const article = document.querySelector('article');
    if (!article || (article as HTMLElement).dataset.copyAttribution) return;
    (article as HTMLElement).dataset.copyAttribution = 'true';

    article.addEventListener('copy', (e: Event) => {
      const selection = document.getSelection();
      const text = selection?.toString() ?? '';
      if (text.length < 120) return; // short quotes stay as-is

      // Never append attribution to code — it would break when pasted
      const anchor = selection?.anchorNode;
      const el = anchor instanceof Element ? anchor : anchor?.parentElement;
      if (el?.closest('pre')) return;

      const attribution = `\n\n— ${document.title}\n${location.href}\n© Furkan Eşref Yazıcı · CC BY-NC-ND 4.0 (attribution required, non-commercial, no derivatives)`;
      const clipboard = (e as ClipboardEvent).clipboardData;
      if (clipboard) {
        clipboard.setData('text/plain', text + attribution);
        e.preventDefault();
      }
    });
  }

  // Copy button on every code block (Shiki renders static <pre>, so we add it here)
  function initCodeCopy() {
    document.querySelectorAll<HTMLPreElement>('.prose pre').forEach((pre) => {
      if (pre.closest('.code-frame')) return;
      const frame = document.createElement('div');
      frame.className = 'code-frame';
      pre.parentNode?.insertBefore(frame, pre);
      frame.appendChild(pre);

      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'code-copy';
      btn.setAttribute('aria-label', 'Copy code');
      const copyIcon =
        '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="8" y="8" width="12" height="12" rx="2"/><path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2"/></svg>';
      const checkIcon =
        '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5L20 7"/></svg>';
      btn.innerHTML = copyIcon;
      btn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(pre.innerText.replace(/\n$/, ''));
          btn.innerHTML = checkIcon;
          btn.classList.add('copied');
          setTimeout(() => {
            btn.innerHTML = copyIcon;
            btn.classList.remove('copied');
          }, 2000);
        } catch {
          /* clipboard unavailable — leave the button as-is */
        }
      });
      frame.appendChild(btn);
    });
  }

  // One floating tooltip, shared by citation previews and glossary terms
  let tip: HTMLDivElement | null = null;

  function showTip(anchor: Element, fill: (tip: HTMLDivElement) => void) {
    hideTip();
    tip = document.createElement('div');
    tip.className = 'footnote-tooltip';
    tip.setAttribute('role', 'tooltip');
    fill(tip);
    // Inside <main>, so the tooltip belongs to the page's landmarks
    (document.querySelector('main') ?? document.body).appendChild(tip);

    const r = anchor.getBoundingClientRect();
    const width = Math.min(360, window.innerWidth - 24);
    tip.style.width = `${width}px`;
    let left = r.left + r.width / 2 - width / 2;
    left = Math.max(12, Math.min(left, window.innerWidth - width - 12));
    tip.style.left = `${left + window.scrollX}px`;
    const height = tip.offsetHeight;
    const above = r.top - height - 10 >= 0;
    tip.style.top = `${(above ? r.top - height - 10 : r.bottom + 10) + window.scrollY}px`;
  }

  function hideTip() {
    tip?.remove();
    tip = null;
  }

  // Hover previews for citations: peek at the reference without losing your place
  function initFootnotePreviews() {
    if (window.matchMedia('(hover: none)').matches) return; // touch: tapping jumps to References
    // Footnote markers and citations ([1] → bibliography entry) alike
    document.querySelectorAll<HTMLAnchorElement>('a[data-footnote-ref], a[href^="#bib-"]').forEach((ref) => {
      if (ref.dataset.fnPreview) return;
      ref.dataset.fnPreview = 'true';

      const show = () => {
        // A footnote already shown beside the text as a sidenote needs no tooltip
        if (ref.matches('[data-footnote-ref]') && document.documentElement.classList.contains('has-sidenotes')) return;
        const id = decodeURIComponent((ref.getAttribute('href') || '').slice(1));
        const note = document.getElementById(id);
        if (!note) return;
        const clone = note.cloneNode(true) as HTMLElement;
        clone.querySelectorAll('[data-footnote-backref]').forEach((a) => a.remove());
        showTip(ref, (t) => {
          t.innerHTML = clone.innerHTML;
        });
      };

      ref.addEventListener('mouseenter', show);
      ref.addEventListener('mouseleave', hideTip);
      ref.addEventListener('focus', show);
      ref.addEventListener('blur', hideTip);
    });
  }

  // Glossary terms (<Term>): hover, keyboard focus or a tap shows the definition
  function initTerms() {
    document.querySelectorAll<HTMLButtonElement>('.term').forEach((term) => {
      if (term.dataset.termReady) return;
      term.dataset.termReady = 'true';
      const show = () =>
        showTip(term, (t) => {
          t.classList.add('term-tooltip');
          if (term.dataset.termLang) t.lang = term.dataset.termLang;
          t.textContent = term.dataset.term || '';
        });
      term.addEventListener('mouseenter', show);
      term.addEventListener('mouseleave', hideTip);
      term.addEventListener('focus', show);
      term.addEventListener('blur', hideTip);
      term.addEventListener('click', show); // touch screens: a tap focuses and shows
      term.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') hideTip();
      });
    });
  }

  // Sidenotes: on wide screens, each footnote is repeated in the left margin
  // beside the line that cites it, so it can be read without jumping to the end.
  // The numbered notes at the end stay (screen readers, print, small screens).
  function initSidenotes() {
    const rail = document.querySelector<HTMLElement>('[data-sidenotes]');
    const body = document.querySelector<HTMLElement>('.post-body');
    const refs = [...document.querySelectorAll<HTMLAnchorElement>('.post-body a[data-footnote-ref]')];
    if (!rail || !body || refs.length === 0) return;
    const wide = window.matchMedia('(min-width: 1280px)');
    const boxes = new Map<HTMLAnchorElement, HTMLElement>();
    // Pointing at a marker highlights its note
    refs.forEach((ref) => {
      ref.addEventListener('mouseenter', () => boxes.get(ref)?.classList.add('is-active'));
      ref.addEventListener('mouseleave', () => boxes.get(ref)?.classList.remove('is-active'));
    });

    let frame = 0;
    const layout = () => {
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(() => {
        rail.replaceChildren();
        boxes.clear();
        document.documentElement.classList.toggle('has-sidenotes', wide.matches);
        if (!wide.matches) return;
        const railTop = rail.getBoundingClientRect().top;
        let floor = 0;
        refs.forEach((ref) => {
          const note = document.getElementById(decodeURIComponent((ref.getAttribute('href') || '').slice(1)));
          if (!note) return;
          const clone = note.cloneNode(true) as HTMLElement;
          clone.querySelectorAll('[data-footnote-backref]').forEach((a) => a.remove());
          const box = document.createElement('div');
          box.className = 'sidenote';
          const number = document.createElement('span');
          number.className = 'sidenote-number';
          number.textContent = ref.textContent || '';
          box.append(number, ...clone.childNodes);
          rail.append(box);
          // Level with the citing line, below the previous note if they'd overlap
          const top = Math.max(ref.getBoundingClientRect().top - railTop - 4, floor);
          box.style.top = `${top}px`;
          floor = top + box.offsetHeight + 16;
          boxes.set(ref, box);
        });
      });
    };

    layout();
    wide.addEventListener('change', layout);
    // Text size changes, images and charts loading, proofs opening: re-place the notes
    new ResizeObserver(layout).observe(body);
  }

  function initPostEnhancements() {
    initCopyAttribution();
    initCodeCopy();
    initFootnotePreviews();
    initTerms();
    initSidenotes();
  }

  initPostEnhancements();
</script>
