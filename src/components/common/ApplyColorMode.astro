---
import { createHash } from 'node:crypto';
import { UI } from '../../utils/config';

const theme: string = UI.theme || 'system';

// A fixed theme ("dark:only" / "light:only") needs no script: Layout writes
// the class onto <html> directly. Otherwise the theme has to be applied before
// first paint (no light/dark flash), so this stays a synchronous inline script
// in <head>. Inline scripts aren't hashed by Astro automatically, so the exact
// text rendered below is hashed here and registered with the page's CSP.
const isFixed = theme.endsWith(':only');

const code = `(function () {
  var defaultTheme = ${JSON.stringify(theme)};
  var stored = null;
  try { stored = localStorage.theme; } catch (e) {}
  var dark = stored
    ? stored === 'dark'
    : defaultTheme === 'system'
      ? window.matchMedia('(prefers-color-scheme: dark)').matches
      : defaultTheme === 'dark';
  document.documentElement.classList.toggle('dark', dark);
})();`;

if (!isFixed) {
  Astro.csp?.insertScriptHash(`sha256-${createHash('sha256').update(code).digest('base64')}`);
}
---

{!isFixed && <script is:inline set:html={code} />}
