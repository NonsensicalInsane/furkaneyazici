---
import { UI } from '../../utils/config';
---

<script is:inline define:vars={{ defaultTheme: UI.theme }}>
  (function () {
  if (window.basic_script) {
    return;
  }

  window.basic_script = true;

  function applyTheme(theme) {
    if (theme === 'dark') {
      document.documentElement.classList.add('dark');
    } else {
      document.documentElement.classList.remove('dark');
    }
  }

  const initTheme = function () {
    if ((defaultTheme && defaultTheme.endsWith(':only')) || (!localStorage.theme && defaultTheme !== 'system')) {
      applyTheme(defaultTheme.replace(':only', ''));
    } else if (
      localStorage.theme === 'dark' ||
      (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)
    ) {
      applyTheme('dark');
    } else {
      applyTheme('light');
    }
  };
  initTheme();

  function attachEvent(selector, event, fn) {
    const matches = typeof selector === 'string' ? document.querySelectorAll(selector) : selector;
    if (matches && matches.length) {
      matches.forEach((elem) => {
        elem.addEventListener(event, (e) => fn(e, elem), false);
      });
    }
  }

  // Mobile menu. One place opens/closes it, and the toggle button reports the
  // state through aria-expanded so screen readers know whether it's open.
  function setMenuOpen(open) {
    const toggle = document.querySelector('[data-aw-toggle-menu]');
    const header = document.getElementById('header');
    toggle?.classList.toggle('expanded', open);
    toggle?.setAttribute('aria-expanded', String(open));
    document.body.classList.toggle('overflow-hidden', open);
    header?.classList.toggle('h-screen', open);
    header?.classList.toggle('expanded', open);
    header?.classList.toggle('bg-page', open);
    document.querySelector('#header nav')?.classList.toggle('hidden', !open);
    document.querySelector('#header > div > div:last-child')?.classList.toggle('hidden', !open);
  }

  // Sticky-header styling on scroll. `document` and `window` survive
  // client-side navigation, so these listeners are added once here — inside
  // onLoad (which re-runs after every navigation) they used to pile up, one
  // more scroll handler per page visited.
  let ticking = false;
  function applyHeaderStylesOnScroll() {
    ticking = false;
    document.querySelector('#header[data-aw-sticky-header]')?.classList.toggle('scroll', window.scrollY > 60);
  }
  document.addEventListener(
    'scroll',
    () => {
      if (ticking) return;
      ticking = true;
      window.requestAnimationFrame(applyHeaderStylesOnScroll);
    },
    { passive: true }
  );

  // Leaving the mobile breakpoint closes the menu
  window.matchMedia('(max-width: 767px)').addEventListener('change', () => setMenuOpen(false));

  // Per-page wiring: the header is replaced on every navigation, so its
  // elements need their listeners attached again each time.
  const onLoad = function () {
    attachEvent('#header nav', 'click', () => setMenuOpen(false));

    attachEvent('[data-aw-toggle-menu]', 'click', (_, elem) => setMenuOpen(!elem.classList.contains('expanded')));

    attachEvent('[data-aw-toggle-color-scheme]', 'click', function () {
      if (defaultTheme.endsWith(':only')) {
        return;
      }
      document.documentElement.classList.toggle('dark');
      localStorage.theme = document.documentElement.classList.contains('dark') ? 'dark' : 'light';
    });

    applyHeaderStylesOnScroll();
  };
  const onPageShow = function () {
    document.documentElement.classList.add('motion-safe:scroll-smooth');
    setMenuOpen(false);
  };

  window.onload = onLoad;
  window.onpageshow = onPageShow;

  document.addEventListener('astro:after-swap', () => {
    initTheme();
    onLoad();
    onPageShow();
  });
  })();
</script>

<script is:inline>
  // Global scroll-reveal: reveal .scroll-reveal elements as they enter the
  // viewport. IntersectionObserver-based (no scroll polling), and everything
  // is revealed immediately for users who prefer reduced motion.
  (function () {
    let observer = null;

    function initScrollReveal() {
      if (observer) {
        observer.disconnect();
        observer = null;
      }

      const elements = document.querySelectorAll('.scroll-reveal:not(.revealed)');
      if (!elements.length) return;

      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) {
        elements.forEach((el) => el.classList.add('revealed'));
        return;
      }

      observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('revealed');
              observer.unobserve(entry.target);
            }
          });
        },
        { rootMargin: '0px 0px -80px 0px', threshold: 0.1 }
      );

      elements.forEach((el) => observer.observe(el));
    }

    document.addEventListener('DOMContentLoaded', initScrollReveal);
    document.addEventListener('astro:page-load', initScrollReveal);
    document.addEventListener('astro:after-swap', initScrollReveal);
  })();
</script>

<script is:inline>
  // Spotlight hover: track the cursor inside cards via CSS variables.
  // One delegated listener for the whole document — no per-card handlers.
  (function () {
    if (window.spotlight_script) return;
    window.spotlight_script = true;

    document.addEventListener(
      'pointermove',
      (e) => {
        const card = e.target instanceof Element && e.target.closest('.project-card, .modern-card');
        if (!card) return;
        const rect = card.getBoundingClientRect();
        card.style.setProperty('--mx', `${e.clientX - rect.left}px`);
        card.style.setProperty('--my', `${e.clientY - rect.top}px`);
      },
      { passive: true }
    );
  })();
</script>

<script is:inline>
  // Count-up: numbers in [data-countup] elements count from 0 when they
  // enter the viewport (once, ~1s). Non-numeric suffixes like "+" are kept.
  (function () {
    function animateCount(el) {
      const raw = el.textContent.trim();
      const match = raw.match(/^(\d+)(.*)$/);
      if (!match) return;
      const target = parseInt(match[1], 10);
      const suffix = match[2] || '';
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduced || target === 0) return; // leave final value as-is

      const duration = 1000;
      const start = performance.now();
      function tick(now) {
        const t = Math.min((now - start) / duration, 1);
        const eased = 1 - Math.pow(1 - t, 3); // ease-out cubic
        el.textContent = Math.round(eased * target) + suffix;
        if (t < 1) requestAnimationFrame(tick);
      }
      el.textContent = '0' + suffix;
      requestAnimationFrame(tick);
    }

    function initCountUp() {
      const els = document.querySelectorAll('[data-countup]:not([data-countup-done])');
      if (!els.length) return;

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.setAttribute('data-countup-done', '');
              animateCount(entry.target);
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.5 }
      );
      els.forEach((el) => observer.observe(el));
    }

    document.addEventListener('DOMContentLoaded', initCountUp);
    document.addEventListener('astro:page-load', initCountUp);
    document.addEventListener('astro:after-swap', initCountUp);
  })();
</script>
