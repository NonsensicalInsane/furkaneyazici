---
import { getAsset } from '../../utils/permalinks';
import { SITE, APP_BLOG } from '../../utils/config';
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<!-- Browser chrome (mobile address bar) matches the dark page background -->
<meta name="theme-color" content="rgb(3 6 23)" />

<link rel="sitemap" href={getAsset('/sitemap-index.xml')} />
<!-- Feed auto-discovery for readers and browsers -->
{
  APP_BLOG.isEnabled && (
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name}’s Blog`} href={getAsset('/rss.xml')} />
  )
}
