---
// A static figure (e.g. a matplotlib SVG) with a numbered caption; click or
// press Enter to view it enlarged.
//
//   import lossCurve from '~/assets/images/posts/my-post/loss.svg';
//   <Figure src={lossCurve} alt="Training loss falling from 2.3 to 0.4" id="fig:loss">
//     Training loss per epoch.
//   </Figure>
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import FigureFrame from './FigureFrame.astro';

export interface Props {
  /** An imported image (preferred: optimised at build) or a path under public/ */
  src: ImageMetadata | string;
  /** What the figure shows, for screen readers and if the image can't load */
  alt: string;
  /** Label for <Ref to="…" />, e.g. "fig:loss" */
  id?: string;
  /** Set by remark-numbering.mjs */
  number?: string;
  /** Display width in px (defaults to the image's own width) */
  width?: number;
}

const { src, alt, id, number, width } = Astro.props;
---

<FigureFrame id={id} number={number}>
  <button
    type="button"
    class="rich-figure-zoom"
    data-figure-zoom
    aria-label={number ? `Enlarge figure ${number}` : 'Enlarge figure'}
  >
    {
      typeof src === 'string' ? (
        <img src={src} alt={alt} width={width} loading="lazy" decoding="async" />
      ) : (
        <Image src={src} alt={alt} width={width} loading="lazy" decoding="async" />
      )
    }
  </button>
  <slot slot="caption" />
</FigureFrame>

<script>
  import { initFigureZoom } from '../../scripts/figure-zoom.js';

  initFigureZoom();
</script>
