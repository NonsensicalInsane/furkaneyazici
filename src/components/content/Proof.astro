---
import { ui } from '../../i18n/ui';
// A collapsible proof, closed by default so readers can skip it, ending in ∎.
//
//   <Proof>
//     Suppose a unitary U copies arbitrary states …
//   </Proof>
export interface Props {
  /** Summary text (default "Proof", in the post's language) */
  title?: string;
  /** Start expanded */
  open?: boolean;
}

const t = ui(Astro.locals.postLang);
const { title = t.proof, open = false } = Astro.props;
---

<details class="proof" open={open}>
  <summary>{title}</summary>
  <slot />
  <p class="proof-qed" aria-label={t.endOfProof}>∎</p>
</details>
