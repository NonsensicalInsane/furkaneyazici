---
export interface Props {
  density?: number;
  className?: string;
}

const { density = 100, className = '' } = Astro.props;
---

<div
  id="particle-container"
  class={`fixed inset-0 pointer-events-none z-0 transition-opacity duration-700 ${className}`}
  aria-hidden="true"
>
  <canvas id="particle-canvas" class="w-full h-full"></canvas>
</div>

<script is:inline define:vars={{ density }}>
  (() => {
    // Respect users who prefer less motion: no particles at all.
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    class ParticleSystem {
      constructor(canvas) {
        this.canvas = canvas;
        this.ctx = canvas.getContext('2d');
        this.particles = [];
        this.mouse = { x: -9999, y: -9999 };
        this.animationId = null;
        this.running = false;
        this.dpr = Math.min(window.devicePixelRatio || 1, 2);

        this.onResize = this.debounce(() => {
          this.resize(); // resizing the canvas clears it
          this.createParticles();
          if (!this.running) this.frame(); // paused: repaint the still frame
        }, 200);
        this.onMouseMove = (e) => {
          this.mouse.x = e.clientX;
          this.mouse.y = e.clientY;
        };

        this.resize();
        this.createParticles();
        window.addEventListener('resize', this.onResize);
        window.addEventListener('mousemove', this.onMouseMove, { passive: true });
      }

      debounce(fn, ms) {
        let t;
        return (...args) => {
          clearTimeout(t);
          t = setTimeout(() => fn(...args), ms);
        };
      }

      resize() {
        this.width = window.innerWidth;
        this.height = window.innerHeight;
        this.canvas.width = this.width * this.dpr;
        this.canvas.height = this.height * this.dpr;
        this.ctx.setTransform(this.dpr, 0, 0, this.dpr, 0, 0);
      }

      createParticles() {
        // Cap the count: connections are O(n²), so keep n small.
        const isMobile = this.width < 768;
        const base = Math.floor((this.width * this.height) / 24000) * (density / 100);
        const count = Math.min(Math.floor(base), isMobile ? 30 : 70);

        this.particles = [];
        for (let i = 0; i < count; i++) {
          this.particles.push({
            x: Math.random() * this.width,
            y: Math.random() * this.height,
            vx: (Math.random() - 0.5) * 0.5,
            vy: (Math.random() - 0.5) * 0.5,
            size: Math.random() * 2 + 1,
            opacity: Math.random() * 0.5 + 0.2,
            hue: Math.random() * 60 + 210, // blue → violet, matches the brand palette
          });
        }
      }

      start() {
        if (this.running) return;
        this.running = true;
        this.animate();
      }

      stop() {
        this.running = false;
        if (this.animationId) {
          cancelAnimationFrame(this.animationId);
          this.animationId = null;
        }
      }

      animate() {
        if (!this.running) return;
        this.frame();
        this.animationId = requestAnimationFrame(() => this.animate());
      }

      // Advance and draw one frame (also used to paint a still frame when the
      // page opens already scrolled past the first viewport).
      frame() {
        const ctx = this.ctx;
        ctx.clearRect(0, 0, this.width, this.height);

        const ps = this.particles;
        for (let i = 0; i < ps.length; i++) {
          const p = ps[i];
          p.x += p.vx;
          p.y += p.vy;

          // Gentle mouse repulsion (vector points from the cursor to the particle)
          const dx = p.x - this.mouse.x;
          const dy = p.y - this.mouse.y;
          const dist = Math.hypot(dx, dy);
          if (dist > 0 && dist < 100) {
            const force = (100 - dist) / 100;
            p.vx += (dx / dist) * force * 0.02;
            p.vy += (dy / dist) * force * 0.02;
          }

          // Ease pushed particles back toward cruising speed (initial max ≈ 0.35)
          // so repeated pushes don't accumulate into ever-faster motion.
          const speed = Math.hypot(p.vx, p.vy);
          if (speed > 0.6) {
            p.vx *= 0.96;
            p.vy *= 0.96;
          }

          // Bounce off edges
          if (p.x < 0 || p.x > this.width) p.vx *= -1;
          if (p.y < 0 || p.y > this.height) p.vy *= -1;
          p.x = Math.max(0, Math.min(this.width, p.x));
          p.y = Math.max(0, Math.min(this.height, p.y));

          ctx.beginPath();
          ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
          ctx.fillStyle = `hsla(${p.hue}, 70%, 60%, ${p.opacity})`;
          ctx.fill();

          // Connections (n is capped, so this stays cheap)
          for (let j = i + 1; j < ps.length; j++) {
            const q = ps[j];
            const cdx = p.x - q.x;
            const cdy = p.y - q.y;
            if (Math.abs(cdx) > 120 || Math.abs(cdy) > 120) continue;
            const cdist = Math.hypot(cdx, cdy);
            if (cdist < 120) {
              ctx.beginPath();
              ctx.moveTo(p.x, p.y);
              ctx.lineTo(q.x, q.y);
              ctx.strokeStyle = `hsla(${p.hue}, 70%, 60%, ${0.1 * (1 - cdist / 120)})`;
              ctx.lineWidth = 1;
              ctx.stroke();
            }
          }
        }
      }

      destroy() {
        this.stop();
        window.removeEventListener('resize', this.onResize);
        window.removeEventListener('mousemove', this.onMouseMove);
      }
    }

    let system = null;
    let scrollHandler = null;
    let visibilityHandler = null;

    function teardown() {
      if (system) {
        system.destroy();
        system = null;
      }
      if (scrollHandler) {
        window.removeEventListener('scroll', scrollHandler);
        scrollHandler = null;
      }
      if (visibilityHandler) {
        document.removeEventListener('visibilitychange', visibilityHandler);
        visibilityHandler = null;
      }
    }

    function init() {
      const container = document.getElementById('particle-container');
      const canvas = document.getElementById('particle-canvas');
      if (reducedMotion.matches || !container || !canvas) {
        teardown();
        return;
      }

      // Init fires more than once per page (DOMContentLoaded + astro:page-load,
      // after-swap + page-load); keep the running system on the same canvas.
      if (system && system.canvas === canvas) return;
      teardown();

      system = new ParticleSystem(canvas);

      // Past the first viewport the particles dim and freeze on their last
      // frame: still an ambient presence on every page, but no longer burning
      // CPU/battery on an animation that's barely visible behind content.
      // Scrolling back up (or returning to a hidden tab) resumes it.
      const update = () => {
        const pastHero = window.scrollY > window.innerHeight * 0.9;
        container.style.opacity = pastHero ? '0.35' : '1';
        if (document.hidden || pastHero) {
          system?.stop();
        } else {
          system?.start();
        }
      };

      scrollHandler = system.debounce(update, 100);
      visibilityHandler = update;
      window.addEventListener('scroll', scrollHandler, { passive: true });
      document.addEventListener('visibilitychange', visibilityHandler);
      update();
      if (!system.running) system.frame(); // opened mid-page: show a still frame
    }

    document.addEventListener('DOMContentLoaded', init);
    document.addEventListener('astro:page-load', init);
    document.addEventListener('astro:after-swap', init);
    reducedMotion.addEventListener?.('change', init);
    window.addEventListener('beforeunload', teardown);
  })();
</script>
