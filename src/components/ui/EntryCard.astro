---
import { Icon } from 'astro-icon/components';

export interface Props {
  /** Icon name, e.g. "tabler:atom" */
  icon: string;
  title: string;
  /** Links the title, e.g. to a certificate */
  href?: string;
  /** The line under the title: organisation, place */
  organization?: string;
  organizationUrl?: string;
  dates?: string;
}

const { icon, title, href, organization, organizationUrl, dates } = Astro.props;
const body = await Astro.slots.render('default');
const external = { target: '_blank', rel: 'noopener noreferrer' };
---

<!-- One entry of a CV-style list (experience, education, certificates). Not a link
     as a whole, so it has no hover effect; the links inside it do. -->
<article class="surface-card flex gap-4 sm:gap-6 p-5 sm:p-7">
  <span class="icon-tile w-11 h-11 sm:w-12 sm:h-12">
    <Icon name={icon} class="w-6 h-6" />
  </span>
  <div class="flex-1 min-w-0">
    <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
      <h3 class="text-lg font-semibold leading-snug text-heading">
        {
          href ? (
            <a href={href} class="hover:text-blue-400 transition-colors" {...external}>
              {title}
            </a>
          ) : (
            title
          )
        }
      </h3>
      {dates && <p class="text-sm text-slate-400 tabular-nums whitespace-nowrap">{dates}</p>}
    </div>
    {
      organization && (
        <p class="mt-1 text-slate-300">
          {organizationUrl ? (
            <a href={organizationUrl} class="inline-link" {...external}>
              {organization}
            </a>
          ) : (
            organization
          )}
        </p>
      )
    }
    {body.trim() && <div class="mt-4 space-y-3 leading-relaxed text-slate-300" set:html={body} />}
  </div>
</article>
