---
import { APP_BLOG } from '../../utils/config';

import Grid from '../../components/blog/Grid.astro';
import Headline from '../ui/Headline.astro';
import Button from '../ui/Button.astro';

import { getBlogPermalink } from '../../utils/permalinks';
import { findPostsByIds } from '../../utils/blog';
import WidgetWrapper from '../../components/ui/WidgetWrapper.astro';
import type { Widget } from '../../types';

export interface Props extends Widget {
  title?: string;
  tagline?: string;
  linkText?: string;
  linkUrl?: string | URL;
  information?: string;
  postIds: string[];
}

const {
  title = await Astro.slots.render('title'),
  tagline,
  linkText = 'View all posts',
  linkUrl = getBlogPermalink(),
  information = await Astro.slots.render('information'),
  postIds = [],

  id,
  isDark = false,
  classes = {},
  bg = await Astro.slots.render('bg'),
} = Astro.props;

const posts = APP_BLOG.isEnabled ? await findPostsByIds(postIds) : [];
---

{
  posts.length > 0 && (
    <WidgetWrapper id={id} isDark={isDark} containerClass={classes?.container} bg={bg}>
      <Headline tagline={tagline} title={title} subtitle={information} />
      <Grid posts={posts} centered />
      {APP_BLOG.list.isEnabled && linkText && linkUrl && (
        <div class="mt-10 text-center">
          <Button href={String(linkUrl)} text={linkText} icon="tabler:arrow-right" />
        </div>
      )}
    </WidgetWrapper>
  )
}
