---
import WidgetWrapper from '../ui/WidgetWrapper.astro';
import type { CallToAction, Widget } from '../../types';
import Headline from '../../components/ui/Headline.astro';
import Button from '../../components/ui/Button.astro';
interface Props extends Widget {
  title?: string;
  subtitle?: string;
  tagline?: string;
  callToAction?: CallToAction;
  actions?: string | CallToAction[];
  callPageName?: string;
  callPagePath?: string;
  logo?: string;
  /** Alt text for the logo; empty (decorative) when the text around it already names it */
  logoAlt?: string;
}

const {
  title = await Astro.slots.render('title'),
  subtitle = await Astro.slots.render('subtitle'),
  tagline = await Astro.slots.render('tagline'),
  actions = await Astro.slots.render('actions'),
  callPageName = await Astro.slots.render('callPageName'),
  callPagePath = await Astro.slots.render('callPagePath'),
  id,
  isDark = false,
  classes = {},
  bg = await Astro.slots.render('bg'),
  logo = await Astro.slots.render('logo'),
  logoAlt = '',
} = Astro.props as Props;
---

<WidgetWrapper id={id} isDark={isDark} containerClass={`max-w-6xl mx-auto ${classes?.container ?? ''}`} bg={bg}>
  <div class="cta-panel max-w-3xl mx-auto text-center px-6 py-10 sm:px-12 sm:py-12 rounded-2xl border border-white/10">
    <Headline
      title={title}
      subtitle={subtitle}
      tagline={tagline}
      classes={{
        container: 'mb-0 md:mb-0',
        title: 'text-3xl sm:text-4xl font-bold leading-tighter tracking-tighter font-heading',
        subtitle: 'text-lg sm:text-xl text-slate-300',
      }}
      callPageName={callPageName}
      callPagePath={callPagePath}
    />
    {
      logo && (
        <div class="flex justify-center">
          <img src={logo} alt={logoAlt} width="128" height="128" class="w-32 h-32" />
        </div>
      )
    }

    {
      actions && (
        <div class="max-w-xs sm:max-w-md m-auto flex flex-nowrap flex-col sm:flex-row sm:justify-center gap-4 mt-6">
          {Array.isArray(actions) ? (
            actions.map((action) => (
              <div class="flex w-full sm:w-auto">
                <Button {...(action || {})} class="w-full sm:mb-0" />
              </div>
            ))
          ) : (
            <Fragment set:html={actions} />
          )}
        </div>
      )
    }
  </div>
</WidgetWrapper>

<style>
  /* Not a card (nothing to click on the panel itself), so no hover effect */
  .cta-panel {
    background:
      radial-gradient(120% 100% at 50% 0%, rgb(99 102 241 / 0.12), transparent 60%),
      rgb(255 255 255 / 0.03);
  }
</style>
