---
import { Icon } from 'astro-icon/components';
export interface Props {
  className?: string;
  id?: string;
}

const { className = '', id } = Astro.props as Props;

const channels = [
  { name: 'Email', handle: 'yazici.furkan@proton.me', icon: 'tabler:mail', href: 'mailto:yazici.furkan@proton.me' },
  { name: 'LinkedIn', handle: '@furkaneyazici', icon: 'tabler:brand-linkedin', href: 'https://linkedin.com/in/furkaneyazici' },
  { name: 'GitHub', handle: '@nonsensicalinsane', icon: 'tabler:brand-github', href: 'https://github.com/nonsensicalinsane' },
  { name: 'Instagram', handle: '@furkaneyazici', icon: 'tabler:brand-instagram', href: 'https://instagram.com/furkaneyazici' },
  { name: 'Discord', handle: '@furkaneyazici', icon: 'tabler:brand-discord', href: 'https://discord.com/users/758241023440453634' },
  { name: 'X', handle: '@furkaneyazici', icon: 'tabler:brand-x', href: 'https://x.com/furkaneyazici' },
];
---

<section class={`pb-16 px-6 ${className}`} id={id}>
  <div class="max-w-4xl mx-auto">
    <div class="grid lg:grid-cols-2 gap-12">
      <!-- Other channels: each row is one link -->
      <div class="scroll-reveal">
        <h2 class="text-xl font-semibold mb-6 text-heading">Elsewhere</h2>

        <ul class="space-y-3">
          {
            channels.map(({ name, handle, icon, href }) => (
              <li>
                <a
                  href={href}
                  class="modern-card flex items-center gap-4 p-4"
                  {...(href.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                >
                  <span class="icon-tile w-11 h-11">
                    <Icon name={icon} class="w-6 h-6" />
                  </span>
                  <span>
                    <span class="block font-semibold text-heading">{name}</span>
                    <span class="block text-sm text-blue-400">{handle}</span>
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Contact Form -->
      <div class="scroll-reveal">
        <form
          id="contact-form"
          name="contact"
          method="POST"
          data-netlify="true"
          netlify-honeypot="bot-field"
          class="space-y-6"
        >
          <!-- Netlify Forms: form name + honeypot (spam trap, hidden from humans) -->
          <input type="hidden" name="form-name" value="contact" />
          <p class="hidden" aria-hidden="true">
            <label>Don't fill this out if you're human: <input type="text" name="bot-field" tabindex="-1" autocomplete="off" /></label>
          </p>
          <div>
            <label for="name" class="block text-sm font-medium text-gray-700 dark:text-slate-300 mb-2">
              Full Name *
            </label>
            <input
              type="text"
              id="name"
              name="name"
              required
              maxlength="100"
              class="w-full px-4 py-3 rounded-lg border border-gray-300 dark:border-slate-600 bg-white dark:bg-slate-800 text-gray-900 dark:text-white focus:ring-2 focus:ring-primary focus:border-transparent transition-all duration-200"
              placeholder="Your full name"
            />
          </div>

          <div>
            <label for="email" class="block text-sm font-medium text-gray-700 dark:text-slate-300 mb-2">
              Email Address *
            </label>
            <input
              type="email"
              id="email"
              name="email"
              required
              maxlength="254"
              class="w-full px-4 py-3 rounded-lg border border-gray-300 dark:border-slate-600 bg-white dark:bg-slate-800 text-gray-900 dark:text-white focus:ring-2 focus:ring-primary focus:border-transparent transition-all duration-200"
              placeholder="your.email@example.com"
            />
          </div>

          <div>
            <label for="subject" class="block text-sm font-medium text-gray-700 dark:text-slate-300 mb-2">
              Subject *
            </label>
            <select
              id="subject"
              name="subject"
              required
              class="w-full px-4 py-3 rounded-lg border border-gray-300 dark:border-slate-600 bg-white dark:bg-slate-800 text-gray-900 dark:text-white focus:ring-2 focus:ring-primary focus:border-transparent transition-all duration-200"
            >
              <option value="">Select a topic</option>
              <option value="collaboration">Research Collaboration</option>
              <option value="project">Project Inquiry</option>
              <option value="consultation">Consultation</option>
              <option value="speaking">Speaking Opportunity</option>
              <option value="other">Other</option>
            </select>
          </div>

          <div>
            <label for="message" class="block text-sm font-medium text-gray-700 dark:text-slate-300 mb-2">
              Message *
            </label>
            <textarea
              id="message"
              name="message"
              required
              maxlength="5000"
              rows="6"
              class="w-full px-4 py-3 rounded-lg border border-gray-300 dark:border-slate-600 bg-white dark:bg-slate-800 text-gray-900 dark:text-white focus:ring-2 focus:ring-primary focus:border-transparent transition-all duration-200 resize-none"
              placeholder="Tell me about your project, collaboration idea, or question..."
            ></textarea>
          </div>

          <button
            type="submit"
            class="w-full px-6 py-4 bg-primary hover:bg-primary-600 text-white font-semibold rounded-lg transition-all duration-200 shadow-lg hover:shadow-xl flex items-center justify-center gap-2 disabled:opacity-50 disabled:cursor-not-allowed btn-enhanced"
          >
            <Icon name="tabler:send" class="w-5 h-5" />
            <span id="submit-text">Send Message</span>
          </button>

          <!-- Privacy notice (KVKK / GDPR): what is stored, where, and why -->
          <p class="text-xs text-gray-500 dark:text-slate-400">
            Your name, email address and message are stored with Netlify Forms and used only to reply to you. To have
            them deleted, email
            <a href="mailto:yazici.furkan@proton.me" class="underline hover:text-primary">yazici.furkan@proton.me</a>.
          </p>

          <!-- Success/Error Messages -->
          <div id="form-message" class="hidden p-4 rounded-lg" role="status" aria-live="polite"></div>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  // Scroll reveal is handled globally in BasicScripts.astro.

  function initializeContactForm() {
    const form = document.getElementById('contact-form') as HTMLFormElement;
    const messageDiv = document.getElementById('form-message') as HTMLElement;
    const submitBtn = form?.querySelector('button[type="submit"]') as HTMLButtonElement;
    const submitText = document.getElementById('submit-text') as HTMLElement;
    
    if (form && messageDiv && submitBtn && submitText) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        
        // Show loading state
        submitBtn.disabled = true;
        submitText.textContent = 'Sending...';
        submitBtn.classList.add('opacity-50');
        
        try {
          // Netlify Forms AJAX submission: POST urlencoded data to the page itself
          const formData = new FormData(form);
          const response = await fetch('/', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: new URLSearchParams(formData as unknown as Record<string, string>).toString(),
          });
          
          if (response.ok) {
            messageDiv.className = 'p-4 rounded-lg bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200';
            messageDiv.innerHTML = '✅ <strong>Message sent successfully!</strong> I\'ll get back to you soon.';
            messageDiv.classList.remove('hidden');
            form.reset();
          } else {
            throw new Error('Network response was not ok');
          }
          
        } catch {
          messageDiv.className = 'p-4 rounded-lg bg-red-100 text-red-800 dark:bg-red-900 dark:text-red-200';
          messageDiv.innerHTML = '❌ <strong>Something went wrong.</strong> Please try again or email me directly.';
          messageDiv.classList.remove('hidden');
        }
        
        // Reset button
        submitBtn.disabled = false;
        submitText.textContent = 'Send Message';
        submitBtn.classList.remove('opacity-50');
        
        // Hide message after 10 seconds
        setTimeout(() => {
          messageDiv.classList.add('hidden');
        }, 10000);
      });
    }
  }

  initializeContactForm();
</script>
