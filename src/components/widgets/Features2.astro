---
import WidgetWrapper from '../../components/ui/WidgetWrapper.astro';
import Headline from '../../components/ui/Headline.astro';
import ItemGrid2 from '../../components/ui/ItemGrid2.astro';
import type { Features } from '../../types';

const {
  title = await Astro.slots.render('title'),
  subtitle = await Astro.slots.render('subtitle'),
  tagline = await Astro.slots.render('tagline'),
  items = [],
  columns = 3,
  defaultIcon,

  id,
  isDark = false,
  classes = {},
  bg = await Astro.slots.render('bg'),
} = Astro.props as Features;
---

<WidgetWrapper id={id} isDark={isDark} containerClass={`max-w-7xl mx-auto ${classes?.container ?? ''}`} bg={bg}>
  <Headline title={title} subtitle={subtitle} tagline={tagline} classes={classes?.headline} />
  <ItemGrid2
    items={items}
    columns={columns}
    defaultIcon={defaultIcon}
    classes={{
      container: 'gap-3 sm:gap-4 md:gap-6',
      panel:
        'rounded-lg shadow-[0_4px_30px_rgba(0,0,0,0.1)] dark:shadow-[0_4px_30px_rgba(0,0,0,0.1)] backdrop-blur border border-[#ffffff29] bg-white dark:bg-slate-900 p-4 sm:p-6',
      icon: 'w-8 h-8 sm:w-10 sm:h-10 mb-3 sm:mb-4 text-primary',
      ...((classes?.items as {}) ?? {}),
    }}
  />
</WidgetWrapper>
