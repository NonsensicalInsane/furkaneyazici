---
import { Icon } from 'astro-icon/components';
import { SITE } from '../../utils/config';
import { getHomePermalink } from '../../utils/permalinks';
import logoicon from '../../assets/images/icons/logo.png';
import { Image } from 'astro:assets';

interface Link {
  text?: string;
  href?: string;
  ariaLabel?: string;
  icon?: string;
  target?: string;
}

export interface Props {
  socialLinks: Array<Link>;
  footNote?: string;
  theme?: string;
}

const { socialLinks = [], theme = 'light' } = Astro.props;

const year = new Date().getFullYear();
---

<footer class:list={[{ dark: theme === 'dark' }, 'relative border-t border-gray-200 dark:border-slate-800 not-prose']}>
  <div class="dark:bg-dark absolute inset-0 pointer-events-none" aria-hidden="true"></div>
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 dark:text-slate-300">
    <div class="flex flex-col items-center gap-4 md:flex-row md:justify-between py-8">
      <!-- Identity -->
      <div>
        <a class="inline-flex items-center gap-2 font-bold text-xl" href={getHomePermalink()}>
          <Image src={logoicon} class="rounded-sm" alt="" width={28} height={28} />
          {SITE?.name}
        </a>
      </div>

      <!-- Social -->
      {
        socialLinks?.length ? (
          <ul class="flex flex-wrap justify-center -mx-2">
            {socialLinks.map(({ ariaLabel, href, text, icon, target }) => (
              <li>
                <a
                  class="text-muted dark:text-gray-400 hover:text-primary dark:hover:text-white hover:bg-gray-100 dark:hover:bg-gray-700 focus:outline-none focus:ring-4 focus:ring-gray-200 dark:focus:ring-gray-700 rounded-lg text-sm p-2.5 inline-flex items-center transition-colors"
                  aria-label={ariaLabel}
                  href={href}
                  {...(target ? { target, rel: 'noopener noreferrer' } : {})}
                >
                  {icon && <Icon name={icon} class="w-5 h-5" />}
                  <Fragment set:html={text} />
                </a>
              </li>
            ))}
          </ul>
        ) : (
          ''
        )
      }
    </div>

    <div
      class="py-4 border-t border-gray-200/60 dark:border-slate-800 text-center text-sm text-muted dark:text-slate-400"
    >
      © {year} Furkan Eşref Yazıcı · Content licensed under{' '}
      <a
        href="https://creativecommons.org/licenses/by-nc-nd/4.0/"
        rel="license noopener noreferrer"
        target="_blank"
        class="underline hover:text-primary">CC BY-NC-ND 4.0</a
      >
    </div>
  </div>
</footer>
