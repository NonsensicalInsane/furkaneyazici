---
import '../assets/styles/tailwind.css';
import { I18N, UI } from '../utils/config';

import CommonMeta from '../components/common/CommonMeta.astro';
import Favicons from '../components/Favicons.astro';
import CustomStyles from '../components/CustomStyles.astro';
import ApplyColorMode from '../components/common/ApplyColorMode.astro';
import Metadata from '../components/common/Metadata.astro';
import BasicScripts from '../components/common/BasicScripts.astro';
import ParticleBackground from '../components/effects/ParticleBackground.astro';

import type { MetaData as MetaDataType } from '../types';

export interface Props {
  metadata?: MetaDataType;
}

const { metadata = {} } = Astro.props;
const { language, textDirection } = I18N;
---

<!doctype html>
<!-- A fixed dark theme is set here, with no script (see ApplyColorMode.astro) -->
<html lang={language} dir={textDirection} class:list={['2xl:text-[20px]', { dark: UI.theme === 'dark:only' }]}>
  <head>
    <CommonMeta />
    <Favicons />
    <CustomStyles />
    <ApplyColorMode />
    <Metadata {...metadata} />
    <!-- Signal (non-standard, increasingly respected): no AI training use -->
    <meta name="robots" content="noai, noimageai" />
    <!-- TDMRep: text-and-data-mining rights reserved (EU DSM Directive Art. 4) -->
    <meta name="tdm-reservation" content="1" />
    <!-- Page-specific head additions (e.g. hreflang alternates on translated posts) -->
    <slot name="head" />
  </head>

  <body class="antialiased text-default bg-page tracking-tight">
    <!-- Accessibility: keyboard users can jump straight past the nav -->
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:px-4 focus:py-2 focus:bg-page focus:text-primary focus:rounded-lg focus:shadow-lg"
    >
      Skip to content
    </a>

    <!-- Site-wide ambient particle background (dims after the first viewport) -->
    <ParticleBackground density={60} />
    <slot />

    <BasicScripts />

    <!-- GoatCounter analytics: privacy-friendly, cookieless, no consent banner needed.
         It skips localhost automatically, so dev traffic isn't counted. The script
         is self-hosted (public/js/), so the site loads no third-party code. -->
    <script is:inline data-goatcounter="https://nonsensicalinsane.goatcounter.com/count" async src="/js/goatcounter-count.js"
    ></script>

    <style is:global>
      img {
        content-visibility: auto;
      }
    </style>
  </body>
</html>
