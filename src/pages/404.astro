---
import Layout from '../layouts/PageLayout.astro';
import { Icon } from 'astro-icon/components';

const title = `Error 404`;

const destinations = [
  { href: '/', icon: 'tabler:home', title: 'Home', text: 'Start from the beginning' },
  { href: '/blog/', icon: 'tabler:article', title: 'Blog', text: 'Read the latest posts' },
];
---

<Layout metadata={{ title, robots: { index: false, follow: true } }}>
  <section class="relative min-h-[80vh] flex items-center justify-center px-6 py-16">
    <div class="text-center max-w-xl mx-auto">
      <p class="text-8xl md:text-9xl font-bold tracking-tighter text-gradient">404</p>
      <h1 class="mt-6 text-2xl md:text-3xl font-bold text-heading">Page not found</h1>
      <p class="mt-4 text-lg text-slate-300">The page you're looking for doesn't exist, or it has moved.</p>

      <div class="mt-10 grid sm:grid-cols-2 gap-4 text-left">
        {
          destinations.map(({ href, icon, title, text }) => (
            <a href={href} class="modern-card hover-lift flex items-center gap-4 p-5">
              <span class="icon-tile w-11 h-11">
                <Icon name={icon} class="w-6 h-6" />
              </span>
              <span>
                <span class="block font-semibold text-heading">{title}</span>
                <span class="block text-sm text-slate-400">{text}</span>
              </span>
            </a>
          ))
        }
      </div>

      <p
        class="mt-10 inline-flex items-center gap-2 px-4 py-2 rounded-full border border-blue-400/20 bg-blue-500/10 text-sm text-blue-200"
      >
        <Icon name="tabler:bulb" class="w-4 h-4 shrink-0" />
        <span>n qubits span a 2<sup>n</sup>-dimensional state space; this page just isn't in it.</span>
      </p>
    </div>
  </section>
</Layout>
