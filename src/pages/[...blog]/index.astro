---
import type { InferGetStaticPropsType, GetStaticPaths } from 'astro';

import merge from 'lodash.merge';
import type { ImageMetadata } from 'astro';
import Layout from '../../layouts/PageLayout.astro';
import SinglePost from '../../components/blog/SinglePost.astro';
import ToBlogLink from '../../components/blog/ToBlogLink.astro';

import { getCanonical, getPermalink } from '../../utils/permalinks';
import { getStaticPathsBlogPost, blogPostRobots, findTranslations } from '../../utils/blog';
import { findImage } from '../../utils/images';
import { coverUrl, COVER_WIDTH, COVER_HEIGHT } from '../../utils/covers';
import type { MetaData } from '../../types';
import RelatedPosts from '../../components/blog/RelatedPosts.astro';
import { readingScaleHeadScript, readingScaleHeadScriptHash } from '../../utils/reading-settings';
// KaTeX's stylesheet (plus ~1 MB of fonts it references) is linked only on
// posts that actually contain math; see mathFlagRemarkPlugin.
import katexStylesheet from 'katex/dist/katex.min.css?url';

export const prerender = true;

export const getStaticPaths = (async () => {
  return await getStaticPathsBlogPost();
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { post } = Astro.props as Props;

// The reader's saved text size is applied by an inline head script; allow it in the CSP
Astro.csp?.insertScriptHash(readingScaleHeadScriptHash);

const url = getCanonical(getPermalink(post.permalink, 'post'));
const image = (await findImage(post.image)) as ImageMetadata | string | undefined;

// Other language versions of this post; also emitted as hreflang alternates
// so search engines serve readers the right language.
const translations = await findTranslations(post);
const alternates =
  translations.length > 0
    ? [
        { lang: post.lang, href: String(url) },
        ...translations.map((t) => ({ lang: t.lang, href: String(getCanonical(getPermalink(t.permalink, 'post'))) })),
      ]
    : [];

const metadata = merge(
  {
    title: post.title,
    description: post.excerpt,
    robots: {
      index: blogPostRobots?.index,
      follow: blogPostRobots?.follow,
    },
    openGraph: {
      type: 'article',
      // The post's own image, or its generated cover (src/utils/covers.ts)
      images: image
        ? [{ url: image, width: (image as ImageMetadata)?.width, height: (image as ImageMetadata)?.height }]
        : [{ url: coverUrl(post)!, width: COVER_WIDTH, height: COVER_HEIGHT }],
    },
  },
  { ...(post?.metadata ? { ...post.metadata, canonical: post.metadata?.canonical || url } : {}) }
) as MetaData;
---

<Layout metadata={metadata}>
  <Fragment slot="head">
    <script is:inline set:html={readingScaleHeadScript} />
    {alternates.map(({ lang, href }) => <link rel="alternate" hreflang={lang} href={href} />)}
    {post.hasMath && <link rel="stylesheet" href={katexStylesheet} />}
  </Fragment>
  <SinglePost post={{ ...post, image: image }} url={url} translations={translations} />
  <div class="print:hidden">
    <ToBlogLink />
    <RelatedPosts post={post} />
  </div>
</Layout>
