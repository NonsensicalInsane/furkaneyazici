---
import { Icon } from 'astro-icon/components';
import Layout from '~/layouts/PageLayout.astro';
import Header from '~/components/widgets/Header.astro';
import Image from '~/components/common/Image.astro';
import Headline from '~/components/ui/Headline.astro';
import EntryCard from '~/components/ui/EntryCard.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import myImage from '~/assets/images/me.png';
import aboutData from '~/data/about/index';
import { headerData } from '~/navigation';

// Same menu as every other page, except "About" opens this page's sections
const sectionLinks = [
  { text: 'Research', href: '#research-experience' },
  { text: 'Work', href: '#work-experience' },
  { text: 'Education', href: '#education' },
  { text: 'Certifications', href: '#certifications' },
];
const headerLinks = headerData.links.map((link) =>
  link.href === '/about/' ? { text: link.text, links: sectionLinks } : link
);

const metadata = {
  title: 'About',
  description:
    'About Furkan Eşref Yazıcı, a computational physicist working on deep learning and quantum computing: research, work experience, education and certifications.',
};

const { personal, research, work, earlierWork, education, certifications, socialLinks } = aboutData;

// Key phrases in the introduction are set in bold
const emphasize = (text: string) =>
  text.replace(
    /(interdisciplinary researcher|computational physicist|deep learning|quantum computing)/g,
    '<strong class="font-semibold text-heading">$1</strong>'
  );
// "Summer 2017 – Summer 2017" reads better as "Summer 2017"
const dates = (start: string, end: string) => (start === end ? start : `${start} – ${end}`);
const external = { target: '_blank', rel: 'noopener noreferrer' };
---

<Layout metadata={metadata}>
  <Fragment slot="header">
    <Header links={headerLinks} actions={headerData.actions} isSticky showRssFeed showToggleTheme />
  </Fragment>

  <!-- Intro -->
  <section class="relative md:-mt-[76px] not-prose">
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 md:pt-[76px]">
      <div class="py-14 md:py-20 text-center max-w-4xl mx-auto">
        <p class="eyebrow animate-fade-in-up">About</p>
        <h1 class="mt-4 text-5xl md:text-7xl font-bold leading-tighter tracking-tighter font-heading text-heading animate-fade-in-up delay-150">
          {personal.subtitle} <span class="text-gradient">{personal.name}</span>
        </h1>
        <p class="mt-6 text-xl md:text-2xl text-slate-300 text-balance animate-fade-in-up delay-300">{personal.title}</p>
        <ul class="mt-8 flex flex-wrap justify-center gap-3 animate-fade-in-up delay-500">
          {
            personal.expertise.map((skill) => (
              <li class="px-4 py-1.5 rounded-full border border-blue-400/20 bg-blue-500/10 text-sm font-medium text-blue-200">
                {skill}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- About me -->
  <section class="relative pb-12 md:pb-20" id="about">
    <div class="relative max-w-6xl mx-auto px-4 sm:px-6">
      <div class="grid lg:grid-cols-[1.2fr_1fr] gap-12 lg:gap-16 items-center">
        <div>
          <h2 class="text-3xl md:text-4xl font-bold tracking-tighter text-heading">About me</h2>
          <div class="mt-6 space-y-4 text-lg leading-relaxed text-slate-300">
            {personal.description.map((paragraph) => <p class="text-balance" set:html={emphasize(paragraph)} />)}
          </div>
          <div class="mt-8 flex flex-wrap items-center gap-3">
            <a href={personal.resumeUrl} class="btn-primary" {...external}>
              Download CV
              <Icon name="tabler:download" class="w-5 h-5 ml-2" />
            </a>
            {
              socialLinks.map((link) => (
                <a
                  href={link.url}
                  class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-4 py-2.5 text-sm font-medium text-slate-200 transition-colors hover:border-blue-400/40 hover:bg-blue-500/10"
                  {...external}
                >
                  <Icon name={link.icon} class="w-4 h-4" />
                  {link.name}
                </a>
              ))
            }
          </div>
        </div>

        <div class="relative mx-auto w-full max-w-md">
          <div class="absolute -inset-4 rounded-[2rem] bg-gradient-to-tr from-blue-500/20 to-violet-500/20 blur-2xl" aria-hidden="true">
          </div>
          <Image
            src={myImage}
            alt="Furkan Eşref Yazıcı"
            class="relative w-full rounded-3xl border border-white/10"
            loading="eager"
            width={448}
            height={448}
          />
          <div class="absolute -top-4 -right-2 sm:-right-4 rounded-2xl border border-white/10 bg-slate-900/90 px-4 py-3 text-center shadow-xl">
            <div class="text-2xl font-bold text-blue-400" data-countup>{personal.stats.yearsResearch}</div>
            <div class="text-sm text-slate-300">years of research</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Research -->
  <section class="py-12 md:py-20 scroll-mt-16" id="research-experience">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <Headline
        title="Research experience"
        subtitle="Exploring the frontiers of physics, quantum computing, and machine learning"
      />
      <div class="space-y-6">
        {
          research.map((item) => (
            <EntryCard
              icon={item.icon}
              title={item.title}
              organization={`${item.organization} · ${item.location}`}
              dates={dates(item.startDate, item.endDate)}
            >
              <p>{item.description}</p>
              {item.supervisor && (
                <p class="text-sm text-slate-400">
                  Supervisor:{' '}
                  {item.supervisorUrl ? (
                    <a href={item.supervisorUrl} class="inline-link" {...external}>
                      {item.supervisor}
                    </a>
                  ) : (
                    item.supervisor
                  )}
                </p>
              )}
            </EntryCard>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Work -->
  <section class="py-12 md:py-20 scroll-mt-16" id="work-experience">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <Headline title="Work experience" subtitle="Professional journey in quantum computing and technology" />
      <div class="space-y-6">
        {
          work.map((item) => (
            <EntryCard
              icon={item.icon}
              title={item.title}
              organization={item.location ? `${item.company} · ${item.location}` : item.company}
              organizationUrl={item.companyUrl}
              dates={dates(item.startDate, item.endDate)}
            >
              {item.description.length > 0 && (
                <ul class="list-disc pl-5 space-y-1 marker:text-blue-400">
                  {item.description.map((line) => (
                    <li>{line}</li>
                  ))}
                </ul>
              )}
              {item.projectUrl && (
                <p>
                  Website:{' '}
                  <a href={item.projectUrl} class="inline-link" {...external}>
                    {item.projectLabel ?? item.projectUrl}
                  </a>
                </p>
              )}
              {item.supervisor && (
                <p class="text-sm text-slate-400">
                  Supervisor:{' '}
                  {item.supervisorUrl ? (
                    <a href={item.supervisorUrl} class="inline-link" {...external}>
                      {item.supervisor}
                    </a>
                  ) : (
                    item.supervisor
                  )}
                </p>
              )}
            </EntryCard>
          ))
        }
      </div>
      {
        earlierWork.length > 0 && (
          <div class="mt-10">
            <h3 class="eyebrow">Earlier</h3>
            <ul class="mt-3 divide-y divide-white/10 rounded-2xl border border-white/10">
              {earlierWork.map((item) => (
                <li class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 px-5 py-3.5">
                  <p>
                    <span class="font-medium text-heading">{item.title}</span>
                    <span class="text-slate-400">
                      {' · '}
                      {item.companyUrl ? (
                        <a href={item.companyUrl} class="inline-link" {...external}>
                          {item.company}
                        </a>
                      ) : (
                        item.company
                      )}
                      {item.location && `, ${item.location}`}
                    </span>
                  </p>
                  <p class="text-sm text-slate-400 tabular-nums whitespace-nowrap">{dates(item.startDate, item.endDate)}</p>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </div>
  </section>

  <!-- Education -->
  <section class="py-12 md:py-20 scroll-mt-16" id="education">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <Headline title="Education" subtitle="Academic foundation in physics and computational sciences" />
      <div class="space-y-6">
        {
          education.map((item) => (
            <EntryCard
              icon={item.icon}
              title={item.degree}
              organization={item.institution}
              dates={dates(item.startDate, item.endDate)}
            >
              {item.courses && (
                <div>
                  <p class="text-sm font-medium text-slate-400">Concentration and extra courses</p>
                  <ul class="mt-2 grid sm:grid-cols-2 gap-x-6 gap-y-1 text-sm list-disc pl-5 marker:text-blue-400">
                    {item.courses.map((course) => (
                      <li>{course}</li>
                    ))}
                  </ul>
                </div>
              )}
              {item.description && <p>{item.description}</p>}
            </EntryCard>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Certifications -->
  <section class="py-12 md:py-20 scroll-mt-16" id="certifications">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <Headline
        title="Certifications"
        subtitle="Professional development in data science, machine learning, and quantum computing"
      />
      <ul class="grid gap-x-10 gap-y-8 sm:grid-cols-2">
        {
          certifications.map((item) => (
            <li class="flex gap-3">
              <Icon name={item.icon} class="w-5 h-5 mt-0.5 shrink-0 text-blue-400" />
              <div>
                <h3 class="font-semibold leading-snug text-heading">
                  {item.certificateUrl ? (
                    <a href={item.certificateUrl} class="hover:text-blue-400 transition-colors" {...external}>
                      {item.title}
                    </a>
                  ) : (
                    item.title
                  )}
                </h3>
                <p class="mt-0.5 text-sm text-slate-400">{item.date ? `${item.provider} · ${item.date}` : item.provider}</p>
                <p class="mt-2 text-sm leading-relaxed text-slate-300">{item.description}</p>
                {item.capstoneProject && (
                  <p class="mt-1 text-sm text-slate-300">
                    Capstone project:{' '}
                    <a href={item.capstoneProject.url} class="inline-link" {...external}>
                      {item.capstoneProject.name}
                    </a>
                  </p>
                )}
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Closing: work together, or support the work -->
  <CallToAction
    title="Work with me, or support the work"
    subtitle="I'm open to research collaborations, freelance projects, and illustration commissions. If you enjoy the posts, you can support them on Patreon."
    actions={[
      { variant: 'primary', text: 'Get in touch', href: '/contact/', icon: 'tabler:arrow-right' },
      { text: 'Support on Patreon', href: 'https://www.patreon.com/theFEY', target: '_blank', icon: 'tabler:arrow-up-right' },
    ]}
  />
</Layout>
