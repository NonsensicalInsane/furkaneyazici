---
import Layout from '../layouts/PageLayout.astro';
import HeroText from '../components/widgets/HeroText.astro';
import ContactForm from '../components/widgets/ContactForm.astro';

const metadata = {
  title: 'Contact',
  description:
    'Get in touch with Furkan Eşref Yazıcı about research collaborations, project inquiries, consultation or speaking.',
};
---

<Layout metadata={metadata}>

  <!-- HeroText Widget ******************* -->
  <HeroText
    tagline="Contact"
    title="Get in touch"
    subtitle="Have a project idea, a research collaboration, or a question about a post? I'd love to hear from you."
  />

  <ContactForm className="relative z-10" id="contact" />


</Layout>
