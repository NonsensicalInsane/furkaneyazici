---
import Layout from '../layouts/PageLayout.astro';
import HomeHero from '../components/widgets/HomeHero.astro';
import LinkCards from '../components/widgets/LinkCards.astro';
import Content from '../components/widgets/Content.astro';
import BlogLatestPosts from '../components/widgets/BlogLatestPosts.astro';
import CallToAction from '../components/widgets/CallToAction.astro';
import aboutData from '../data/about/index';
import { toJsonLd } from '../utils/utils';

// Homepage sets the full title itself; skip the "%s — Furkan Eşref Yazıcı" template
const metadata = {
  title: 'Furkan Eşref Yazıcı — Physicist & Quantum Software Engineer',
  ignoreTitleTemplate: true,
};

// The current job, from the About page data: shown under the hero and in the Person schema
const currentJob = aboutData.work.find((job) => job.endDate === 'Present');

// Person schema: tells search engines & AI assistants who this site is about,
// so they can surface and cite it correctly.
const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Furkan Eşref Yazıcı',
  url: 'https://furkaneyazici.com',
  jobTitle: currentJob?.title ?? 'Physicist',
  ...(currentJob ? { worksFor: { '@type': 'Organization', name: currentJob.company, url: currentJob.companyUrl } } : {}),
  knowsAbout: ['Physics', 'Machine Learning', 'Deep Learning', 'Quantum Computing'],
  email: 'mailto:yazici.furkan@proton.me',
  sameAs: [
    'https://github.com/nonsensicalinsane',
    'https://www.linkedin.com/in/furkaneyazici',
    'https://twitter.com/furkaneyazici',
    'https://instagram.com/furkaneyazici',
    'https://www.youtube.com/@furkaneyazici',
  ],
};
---

<Layout metadata={metadata}>
  <script is:inline type="application/ld+json" set:html={toJsonLd(personJsonLd)} />

  <!-- Hero: who, what, and two ways in -->

  <HomeHero
    title="Furkan Eşref Yazıcı"
    tagline="Physicist · Machine Learning · Quantum Computing"
    currently={currentJob && { text: `${currentJob.title} at ${currentJob.company}`, href: currentJob.companyUrl }}
    actions={[
      { variant: 'primary', text: 'Read the blog', href: '/blog/', icon: 'tabler:arrow-right' },
      { text: 'Get in touch', href: '/contact/' },
    ]}
  >
    <Fragment slot="subtitle">
      I research deep learning and quantum computing, and turn that research into software, writing, and
      illustrations.
    </Fragment>
  </HomeHero>

  <!-- What I do: each card leads to the proof -->

  <LinkCards
    id="what-i-do"
    tagline="What I do"
    title="Research, code, and clear explanations"
    items={[
      {
        title: 'Research',
        description: 'Deep learning and quantum computing, from the underlying math to working models.',
        icon: 'tabler:atom',
        href: '/about/#research-experience',
        linkText: 'Research experience',
      },
      {
        title: 'Software',
        description: 'Research code that holds up: quantum optimization, machine learning, and the apps around them.',
        icon: 'tabler:code',
        href: 'https://github.com/nonsensicalinsane',
        linkText: 'Code on GitHub',
      },
      {
        title: 'Writing & illustration',
        description: 'Hard ideas explained with interactive figures, animations, and my own illustrations.',
        icon: 'tabler:pencil',
        href: '/blog/',
        linkText: 'Read the blog',
      },
    ]}
  />

  <!-- Latest blog posts -->

  <BlogLatestPosts
    id="blog"
    tagline="Blog"
    title="Latest writing"
    information="Notes on quantum computing, machine learning, and whatever else I'm exploring."
    linkText="View all posts"
    count={3}
  />

  <!-- About -->

  <Content
    id="about"
    callToAction={{
      text: 'More about me',
      icon: 'tabler:arrow-right',
      href: '/about/',
    }}
    image={{
      src: '~/assets/images/me.png',
      alt: 'Furkan Eşref Yazıcı',
    }}
  >
    <Fragment slot="content">
      <p class="eyebrow">About me</p>
      <h2 class="mt-3 mb-5 text-3xl sm:text-4xl font-bold tracking-tighter text-heading">From theory to application</h2>
      <p class="text-lg leading-relaxed text-slate-300">
        I'm an interdisciplinary researcher specializing in deep learning and quantum computing. The illustrations on
        this site are my own; I'm open to collaborations and commissions.
      </p>
    </Fragment>
  </Content>

  <!-- Contact -->

  <CallToAction
    id="contact"
    tagline="Contact"
    title="Let's work together"
    subtitle="Research collaborations, freelance projects, or a question about a post: I'd like to hear about it."
    actions={[
      { variant: 'primary', text: 'Email me', href: 'mailto:yazici.furkan@proton.me', icon: 'tabler:mail' },
      { text: 'Contact form', href: '/contact/' },
    ]}
  />
</Layout>
