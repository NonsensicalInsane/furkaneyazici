---
import Layout from '../layouts/PageLayout.astro';
import Hero from '../components/widgets/Hero.astro';
import Features3 from '../components/widgets/Features3.astro';
import ProjectShowcase from '../components/widgets/ProjectShowcase.astro';

// Import organized project data
import { featuredProjects } from '../content/projects/featured';
import { upcomingProjects, upcomingProjectsConfig } from '../content/projects/upcoming';

const metadata = {
  title: "Furkan's Projects",
  description:
    'Projects by Furkan Eşref Yazıcı: research and software in machine learning and quantum computing, plus what is in the works.',
};
---

<Layout metadata={metadata}>
  
  <Hero
    title="<span class='text-gradient-animated'>Projects</span>"
    subtitle="Here are some of the projects I have worked on. I am always looking for new projects to work on, so if you have an idea, feel free to contact me!"
    callPageName="Contact"
    callPagePath="/contact/"
  />

  {
    featuredProjects.length > 0 && (
      <ProjectShowcase
        title="<span class='text-gradient'>Featured Projects</span>"
        subtitle="Explore my latest work and contributions"
        projects={featuredProjects}
        showFilter={true}
        columns={3}
      />
    )
  }

  <Features3
    title={upcomingProjectsConfig.title}
    subtitle={upcomingProjectsConfig.subtitle}
    image={upcomingProjectsConfig.heroImage}
    items={upcomingProjects}
    columns={2}
  />
</Layout>
